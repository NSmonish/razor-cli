-      validateStatus: (status) => {
-        return status < 500;
+  const timeout = getHTTPTimeout();
+  // axios' timeout only covers socket inactivity, the signal bounds the entire call
+  const signal = AbortSignal.timeout(timeout);
+  try {
+    const getUserResponse = await axiosHTTPClient.get(
+      `http://localhost/user/${userId}`,
+      {
+        timeout,
+        signal,
+        validateStatus: (status) => {
+          return status < 500;
+        },
       },
-    },
-  );
-  return getUserResponse.data;
+    );
+    return getUserResponse.data;
+  } catch (error) {
+    const isTimeout =
+      signal.aborted ||
+      (error instanceof AxiosError &&
+        (error.code === AxiosError.ECONNABORTED ||
+          error.code === AxiosError.ETIMEDOUT));
+    if (isTimeout) {
+      throw new AppError(
+        'user-verification-timeout',
+        `The users service did not respond within ${timeout}ms`,
+        503,
+      );
+    }
+    throw error;
+  }
 }
