+// Premium users get a 10% discount, rounded up to the nearest whole number
+function calculateFinalPrice(order) {
+  if (order.isPremiumUser !== true || typeof order.totalPrice !== 'number') {
+    return order.totalPrice;
+  }
+  return Math.ceil((order.totalPrice * 9) / 10);
+}
