+// Premium users get a 10% discount on the total price, rounded up to a whole number
+function applyPremiumDiscount(order) {
+  if (order.isPremiumUser !== true || typeof order.totalPrice !== 'number') {
+    return order;
+  }
+  // Integer arithmetic avoids float artifacts (e.g. 70 * 0.9 = 63.00000000000001)
+  const discountedPrice = Math.ceil((order.totalPrice * 9) / 10);
+  return { ...order, totalPrice: discountedPrice };
+}
