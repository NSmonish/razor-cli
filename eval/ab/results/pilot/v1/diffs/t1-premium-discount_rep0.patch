+++ b/example-application/test/createOrder.premiumDiscount.test.ts
@@ -0,0 +1,62 @@
+import { buildOrder } from './order-data-factory';
+import { testSetup } from './setup/test-file-setup';
+
+beforeAll(async () => {
+  await testSetup.start({
+    startAPI: true,
+    disableNetConnect: true,
+    includeTokenInHttpClient: true,
+    mockGetUserCalls: true,
+    mockMailerCalls: true,
+  });
+});
+
+beforeEach(() => {
+  testSetup.resetBeforeEach();
+});
+
+afterAll(async () => {
+  testSetup.tearDownTestFile();
+});
+
+// 🎯 This file is about the premium-user pricing policy
+describe('POST /orders', () => {
+  test.each([
+    { totalPrice: 59, expectedPrice: 54 }, // 53.1 is rounded up
+    { totalPrice: 70, expectedPrice: 63 }, // whole result is not rounded further
+    { totalPrice: 1, expectedPrice: 1 }, // 0.9 is rounded up
+  ])(
+    'When a premium user adds an order of $totalPrice, Then the stored price is $expectedPrice',
+    async ({ totalPrice, expectedPrice }) => {
+      //Arrange
+      const orderToAdd = buildOrder({ isPremiumUser: true, totalPrice });
+
+      //Act
+      const {
+        data: { id: addedOrderId },
+      } = await testSetup.getHTTPClient().post('/order', orderToAdd);
+
+      //Assert
+      const getOrderResponse = await testSetup
+        .getHTTPClient()
+        .get(`/order/${addedOrderId}`);
+      expect(getOrderResponse.data.totalPrice).toBe(expectedPrice);
+    },
+  );
+
+  test('When a non-premium user adds an order, Then the stored price is unchanged', async () => {
+    //Arrange
+    const orderToAdd = buildOrder({ isPremiumUser: false, totalPrice: 59 });
+
+    //Act
+    const {
+      data: { id: addedOrderId },
+    } = await testSetup.getHTTPClient().post('/order', orderToAdd);
+
+    //Assert
+    const getOrderResponse = await testSetup
+      .getHTTPClient()
+      .get(`/order/${addedOrderId}`);
+    expect(getOrderResponse.data.totalPrice).toBe(59);
+  });
+});
