+const DEFAULT_HTTP_TIMEOUT_MS = 2000;
+
+// Read on every call so that changing HTTP_TIMEOUT takes effect without a restart
+function getHTTPTimeout() {
+  const timeout = Number(process.env.HTTP_TIMEOUT);
+  return Number.isFinite(timeout) && timeout > 0
+    ? timeout
+    : DEFAULT_HTTP_TIMEOUT_MS;
+}
