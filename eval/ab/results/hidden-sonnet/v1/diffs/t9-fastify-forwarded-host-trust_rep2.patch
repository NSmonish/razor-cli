+// Whether the direct peer of the connection is a proxy we trust.
+// A null proxyFn means `trustProxy: true`, i.e. trust everything.
+function isTrustedConnection (raw, proxyFn) {
+  if (proxyFn === null) return true
+  const addr = raw.socket?.remoteAddress
+  if (addr === undefined) return false
+  return Boolean(proxyFn(addr, 0))
+}
