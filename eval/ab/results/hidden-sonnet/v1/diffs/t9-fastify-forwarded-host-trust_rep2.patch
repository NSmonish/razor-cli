diff --git a/test/trust-proxy.test.js b/test/trust-proxy.test.js
index ae7b756..4745755 100644
--- a/test/trust-proxy.test.js
+++ b/test/trust-proxy.test.js
@@ -160,3 +160,44 @@ test('trust proxy protocol', async t => {
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxynoprotocol', undefined)
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxyprotocols', 'ipsum, dolor')
 })
+
+test('trust proxy, forwarded host/proto ignored when peer is not trusted', async t => {
+  const cases = [
+    { name: 'string', trustProxy: '10.0.0.1' },
+    { name: 'csv string', trustProxy: '10.0.0.1, 10.0.0.2' },
+    { name: 'array', trustProxy: ['10.0.0.1'] },
+    { name: 'function', trustProxy: (addr) => addr === '10.0.0.1' }
+  ]
+  for (const c of cases) {
+    const app = fastify({ trustProxy: c.trustProxy })
+    t.after(() => app.close())
+    app.get('/', (req) => ({ host: req.host, hostname: req.hostname, protocol: req.protocol }))
+    const res = await app.inject({
+      url: '/',
+      headers: { host: 'real.test', 'x-forwarded-host': 'evil.com', 'x-forwarded-proto': 'https' }
+    })
+    t.assert.deepStrictEqual(res.json(), { host: 'real.test', hostname: 'real.test', protocol: 'http' }, c.name)
+  }
+})
+
+test('trust proxy, forwarded host/proto used when peer is trusted', async t => {
+  const cases = [
+    { name: 'string', trustProxy: '127.0.0.1' },
+    { name: 'cidr', trustProxy: '127.0.0.0/8' },
+    { name: 'array', trustProxy: ['127.0.0.1'] },
+    { name: 'function', trustProxy: (addr) => addr === '127.0.0.1' },
+    { name: 'number', trustProxy: 1 },
+    { name: 'true', trustProxy: true }
+  ]
+  for (const c of cases) {
+    const app = fastify({ trustProxy: c.trustProxy })
+    t.after(() => app.close())
+    app.get('/', (req) => ({ host: req.host, hostname: req.hostname, protocol: req.protocol }))
+    const res = await app.inject({
+      url: '/',
+      remoteAddress: '127.0.0.1',
+      headers: { host: 'real.test', 'x-forwarded-host': 'proxy.test', 'x-forwarded-proto': 'https' }
+    })
+    t.assert.deepStrictEqual(res.json(), { host: 'proxy.test', hostname: 'proxy.test', protocol: 'https' }, c.name)
+  }
+})
