diff --git a/test/content-type.test.js b/test/content-type.test.js
index 1c6b91f..76fba3b 100644
--- a/test/content-type.test.js
+++ b/test/content-type.test.js
@@ -199,3 +199,32 @@ describe('ContentType class cache', () => {
     t.assert.notEqual(contentType1, contentType2)
   })
 })
+
+describe('quoted parameter values', () => {
+  test('semicolon inside quoted value is kept', t => {
+    const ct = new ContentType('multipart/mixed; boundary="part;one"; charset=utf-8')
+    t.assert.strictEqual(ct.parameters.get('boundary'), 'part;one')
+    t.assert.strictEqual(ct.parameters.get('charset'), 'utf-8')
+    t.assert.strictEqual(ct.parameters.size, 2)
+  })
+
+  test('parameters inside quoted value are not parsed', t => {
+    const ct = new ContentType('text/plain; title="lang=en; charset=latin1"')
+    t.assert.strictEqual(ct.parameters.get('title'), 'lang=en; charset=latin1')
+    t.assert.strictEqual(ct.parameters.has('charset'), false)
+  })
+
+  test('escaped quotes and backslashes', t => {
+    const ct = new ContentType('text/plain; a="x\\"; b=1"; c=2')
+    t.assert.strictEqual(ct.parameters.get('a'), 'x"; b=1')
+    t.assert.strictEqual(ct.parameters.has('b'), false)
+    t.assert.strictEqual(ct.parameters.get('c'), '2')
+    t.assert.strictEqual(new ContentType(ct.toString()).parameters.get('a'), 'x"; b=1')
+  })
+
+  test('unterminated quoted value is invalid and swallows the rest', t => {
+    const ct = new ContentType('text/plain; a="x; charset=latin1')
+    t.assert.strictEqual(ct.parameters.get('a'), 'invalid quoted string')
+    t.assert.strictEqual(ct.parameters.has('charset'), false)
+  })
+})
