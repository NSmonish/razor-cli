   })
 
+  test('keeps semicolons inside quoted parameter values', (t) => {
+    const found = new ContentType('multipart/mixed; boundary="part;one"; charset=utf-8')
+    t.assert.equal(found.isValid, true)
+    t.assert.deepEqual([...found.parameters], [
+      ['boundary', 'part;one'],
+      ['charset', 'utf-8']
+    ])
+  })
+
+  test('does not parse parameters inside quoted values', (t) => {
+    const found = new ContentType('text/plain; title="lang=en; charset=latin1"')
+    t.assert.deepEqual([...found.parameters], [['title', 'lang=en; charset=latin1']])
+    t.assert.equal(found.parameters.has('charset'), false)
+    t.assert.equal(found.parameters.has('lang'), false)
+  })
+
+  test('handles escaped characters in quoted values', (t) => {
+    const found = new ContentType('text/plain; a="x\\"; b=1"; c=2')
+    t.assert.deepEqual([...found.parameters], [['a', 'x"; b=1'], ['c', '2']])
+    t.assert.equal(found.toString(), 'text/plain; a="x\\"; b=1"; c="2"')
+  })
+
+  test('unterminated quoted value swallows the rest as invalid', (t) => {
+    const found = new ContentType('text/plain; a="x; charset=latin1')
+    t.assert.deepEqual([...found.parameters], [['a', 'invalid quoted string']])
+  })
