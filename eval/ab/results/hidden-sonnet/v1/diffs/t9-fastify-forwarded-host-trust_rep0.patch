diff --git a/test/trust-proxy.test.js b/test/trust-proxy.test.js
index ae7b756..04b69b2 100644
--- a/test/trust-proxy.test.js
+++ b/test/trust-proxy.test.js
@@ -160,3 +160,46 @@ test('trust proxy protocol', async t => {
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxynoprotocol', undefined)
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxyprotocols', 'ipsum, dolor')
 })
+
+for (const [name, getTp] of [
+  ['string', () => '10.0.0.1'],
+  ['array', () => ['10.0.0.1']],
+  ['comma-separated string', () => '10.0.0.1, 10.0.0.2'],
+  ['function', () => (addr) => addr === '10.0.0.1'],
+  ['number 0 hops (not trusted)', () => 0]
+]) {
+  test(`untrusted peer cannot spoof host/protocol (${name})`, async t => {
+    const app = fastify({ trustProxy: getTp() })
+    t.after(() => app.close())
+    app.get('/', (req, reply) => {
+      reply.send({ host: req.host, hostname: req.hostname, protocol: req.protocol })
+    })
+    const res = await app.inject({
+      url: '/',
+      headers: { host: 'real.test', 'x-forwarded-host': 'evil.com', 'x-forwarded-proto': 'https' }
+    })
+    t.assert.deepStrictEqual(res.json(), { host: 'real.test', hostname: 'real.test', protocol: 'http' })
+  })
+}
+
+for (const [name, tp] of [
+  ['string', '10.0.0.1'],
+  ['array', ['10.0.0.1']],
+  ['function', (addr) => addr === '10.0.0.1'],
+  ['number', 1],
+  ['true', true]
+]) {
+  test(`trusted peer host/protocol are forwarded (${name})`, async t => {
+    const app = fastify({ trustProxy: tp })
+    t.after(() => app.close())
+    app.get('/', (req, reply) => {
+      reply.send({ host: req.host, hostname: req.hostname, protocol: req.protocol })
+    })
+    const res = await app.inject({
+      url: '/',
+      remoteAddress: '10.0.0.1',
+      headers: { host: 'real.test', 'x-forwarded-host': 'fwd.test', 'x-forwarded-proto': 'https' }
+    })
+    t.assert.deepStrictEqual(res.json(), { host: 'fwd.test', hostname: 'fwd.test', protocol: 'https' })
+  })
+}
