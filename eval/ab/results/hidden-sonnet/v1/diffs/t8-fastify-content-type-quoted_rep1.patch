diff --git a/test/content-type.test.js b/test/content-type.test.js
index 1c6b91f..2f40226 100644
--- a/test/content-type.test.js
+++ b/test/content-type.test.js
@@ -198,4 +198,30 @@ describe('ContentType class cache', () => {
     const contentType2 = ContentType.from('text/plain')
     t.assert.notEqual(contentType1, contentType2)
   })
+
+  test('handles semicolons inside quoted parameter values', (t) => {
+    const found = new ContentType('multipart/mixed; boundary="part;one"; charset=utf-8')
+    t.assert.equal(found.isValid, true)
+    t.assert.deepStrictEqual(
+      Array.from(found.parameters.entries()),
+      [['boundary', 'part;one'], ['charset', 'utf-8']]
+    )
+  })
+
+  test('does not parse parameters from inside quoted values', (t) => {
+    const found = new ContentType('text/plain; title="lang=en; charset=latin1"')
+    t.assert.equal(found.parameters.has('charset'), false)
+    t.assert.deepStrictEqual(
+      Array.from(found.parameters.entries()),
+      [['title', 'lang=en; charset=latin1']]
+    )
+  })
+
+  test('handles escaped quotes in quoted values', (t) => {
+    const found = new ContentType('text/plain; a="x\\"; b=1"; c=2')
+    t.assert.deepStrictEqual(
+      Array.from(found.parameters.entries()),
+      [['a', 'x"; b=1'], ['c', '2']]
+    )
+  })
 })
