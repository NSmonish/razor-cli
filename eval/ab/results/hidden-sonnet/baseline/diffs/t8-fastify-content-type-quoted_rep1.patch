diff --git a/test/content-type.test.js b/test/content-type.test.js
index 1c6b91f..ce6fa77 100644
--- a/test/content-type.test.js
+++ b/test/content-type.test.js
@@ -199,3 +199,34 @@ describe('ContentType class cache', () => {
     t.assert.notEqual(contentType1, contentType2)
   })
 })
+
+describe('ContentType quoted parameter values', () => {
+  test('semicolon inside quoted value is part of the value', (t) => {
+    const found = new ContentType('multipart/mixed; boundary="part;one"; charset=utf-8')
+    t.assert.equal(found.parameters.get('boundary'), 'part;one')
+    t.assert.equal(found.parameters.get('charset'), 'utf-8')
+  })
+
+  test('quoted value content is never a separate parameter', (t) => {
+    const found = new ContentType('text/plain; title="lang=en; charset=latin1"')
+    t.assert.equal(found.parameters.get('title'), 'lang=en; charset=latin1')
+    t.assert.equal(found.parameters.has('charset'), false)
+    t.assert.equal(found.parameters.has('lang'), false)
+  })
+
+  test('handles escaped quotes and junk after closing quote', (t) => {
+    let found = new ContentType('text/plain; a="x\\";y=1"; b=2')
+    t.assert.equal(found.parameters.get('a'), 'x";y=1')
+    t.assert.equal(found.parameters.get('b'), '2')
+    t.assert.equal(found.parameters.has('y'), false)
+
+    found = new ContentType('text/plain; a="x"y="p;q=1"; b=2')
+    t.assert.equal(found.parameters.get('a'), 'x')
+    t.assert.equal(found.parameters.has('q'), false)
+  })
+
+  test('toString round-trips quoted values', (t) => {
+    const found = new ContentType('text/plain; a="x\\";y"')
+    t.assert.equal(found.toString(), 'text/plain; a="x\\";y"')
+  })
+})
