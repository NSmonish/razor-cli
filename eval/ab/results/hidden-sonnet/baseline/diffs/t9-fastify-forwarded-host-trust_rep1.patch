diff --git a/test/trust-proxy.test.js b/test/trust-proxy.test.js
index ae7b756..147e8e6 100644
--- a/test/trust-proxy.test.js
+++ b/test/trust-proxy.test.js
@@ -160,3 +160,42 @@ test('trust proxy protocol', async t => {
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxynoprotocol', undefined)
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxyprotocols', 'ipsum, dolor')
 })
+
+test('forwarded host and proto are ignored when peer is not a trusted proxy', async t => {
+  for (const trustProxy of ['10.0.0.1', ['10.0.0.1'], (addr) => addr === '10.0.0.1']) {
+    const app = fastify({ trustProxy })
+    t.after(() => app.close())
+    app.get('/', (req, reply) => {
+      reply.send({ host: req.host, hostname: req.hostname, protocol: req.protocol })
+    })
+    const res = await app.inject({
+      url: '/',
+      headers: { host: 'real.test', 'x-forwarded-host': 'evil.com', 'x-forwarded-proto': 'https' },
+      remoteAddress: '9.9.9.9'
+    })
+    t.assert.deepStrictEqual(res.json(), { host: 'real.test', hostname: 'real.test', protocol: 'http' })
+
+    const trusted = await app.inject({
+      url: '/',
+      headers: { host: 'real.test', 'x-forwarded-host': 'proxied.test', 'x-forwarded-proto': 'https' },
+      remoteAddress: '10.0.0.1'
+    })
+    t.assert.deepStrictEqual(trusted.json(), { host: 'proxied.test', hostname: 'proxied.test', protocol: 'https' })
+  }
+})
+
+test('trustProxy number and true keep trusting forwarded headers', async t => {
+  for (const trustProxy of [1, true]) {
+    const app = fastify({ trustProxy })
+    t.after(() => app.close())
+    app.get('/', (req, reply) => {
+      reply.send({ host: req.host, protocol: req.protocol })
+    })
+    const res = await app.inject({
+      url: '/',
+      headers: { host: 'real.test', 'x-forwarded-host': 'proxied.test', 'x-forwarded-proto': 'https' },
+      remoteAddress: '9.9.9.9'
+    })
+    t.assert.deepStrictEqual(res.json(), { host: 'proxied.test', protocol: 'https' })
+  }
+})
