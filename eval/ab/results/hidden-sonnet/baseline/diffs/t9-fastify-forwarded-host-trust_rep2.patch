diff --git a/test/trust-proxy.test.js b/test/trust-proxy.test.js
index ae7b756..325df71 100644
--- a/test/trust-proxy.test.js
+++ b/test/trust-proxy.test.js
@@ -160,3 +160,45 @@ test('trust proxy protocol', async t => {
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxynoprotocol', undefined)
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxyprotocols', 'ipsum, dolor')
 })
+
+test('untrusted direct connection ignores x-forwarded-host/proto', async t => {
+  const configs = [
+    ['ip array', ['10.9.9.9']],
+    ['ip string', '10.9.9.9'],
+    ['function', (address) => address === '10.9.9.9'],
+    ['number 0-hop equivalent', 1, true]
+  ]
+  for (const [name, trustProxy, trusted] of configs) {
+    const app = fastify({ trustProxy })
+    t.after(() => app.close())
+    app.get('/', (req, reply) => {
+      reply.send({ host: req.host, hostname: req.hostname, protocol: req.protocol })
+    })
+    const address = await app.listen({ port: 0, host: '127.0.0.1' })
+    const res = await fetch(address, {
+      headers: { 'X-Forwarded-Host': 'evil.com', 'X-Forwarded-Proto': 'https' }
+    })
+    const body = await res.json()
+    if (trusted) {
+      t.assert.strictEqual(body.host, 'evil.com', name)
+      t.assert.strictEqual(body.protocol, 'https', name)
+    } else {
+      t.assert.strictEqual(body.host, `127.0.0.1:${app.server.address().port}`, name)
+      t.assert.strictEqual(body.hostname, '127.0.0.1', name)
+      t.assert.strictEqual(body.protocol, 'http', name)
+    }
+  }
+})
+
+test('trusted direct connection uses x-forwarded-host/proto', async t => {
+  const app = fastify({ trustProxy: '127.0.0.1' })
+  t.after(() => app.close())
+  app.get('/', (req, reply) => {
+    reply.send({ host: req.host, protocol: req.protocol })
+  })
+  const address = await app.listen({ port: 0, host: '127.0.0.1' })
+  const res = await fetch(address, {
+    headers: { 'X-Forwarded-Host': 'good.com', 'X-Forwarded-Proto': 'https' }
+  })
+  t.assert.deepStrictEqual(await res.json(), { host: 'good.com', protocol: 'https' })
+})
