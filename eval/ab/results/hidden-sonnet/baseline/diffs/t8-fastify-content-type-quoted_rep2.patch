+  test('handles semicolons and parameter-like text in quoted values', (t) => {
+    let found = new ContentType('multipart/mixed; boundary="part;one"; charset=utf-8')
+    t.assert.equal(found.parameters.get('boundary'), 'part;one')
+    t.assert.equal(found.parameters.get('charset'), 'utf-8')
+
+    found = new ContentType('text/plain; title="lang=en; charset=latin1"')
+    t.assert.equal(found.parameters.get('title'), 'lang=en; charset=latin1')
+    t.assert.equal(found.parameters.has('charset'), false)
+    t.assert.equal(found.parameters.has('lang'), false)
+
+    found = new ContentType('text/plain; a="x\\"y;b=c"; d=e')
+    t.assert.equal(found.parameters.get('a'), 'x"y;b=c')
+    t.assert.equal(found.parameters.has('b'), false)
+    t.assert.equal(found.parameters.get('d'), 'e')
+
+    found = new ContentType('text/plain; bad key="x;c=d"; e=f')
+    t.assert.equal(found.parameters.has('c'), false)
+    t.assert.equal(found.parameters.get('e'), 'f')
+  })
