diff --git a/test/content-type.test.js b/test/content-type.test.js
index 1c6b91f..e30cf75 100644
--- a/test/content-type.test.js
+++ b/test/content-type.test.js
@@ -199,3 +199,40 @@ describe('ContentType class cache', () => {
     t.assert.notEqual(contentType1, contentType2)
   })
 })
+
+describe('ContentType quoted parameter values', () => {
+  test('semicolon inside quoted value is kept and later params parse', t => {
+    const ct = new ContentType('multipart/mixed; boundary="part;one"; charset=utf-8')
+    t.assert.strictEqual(ct.isValid, true)
+    t.assert.strictEqual(ct.parameters.get('boundary'), 'part;one')
+    t.assert.strictEqual(ct.parameters.get('charset'), 'utf-8')
+  })
+
+  test('content of a quoted value is never a parameter', t => {
+    const ct = new ContentType('text/plain; title="lang=en; charset=latin1"')
+    t.assert.strictEqual(ct.parameters.get('title'), 'lang=en; charset=latin1')
+    t.assert.strictEqual(ct.parameters.has('charset'), false)
+    t.assert.strictEqual(ct.parameters.has('lang'), false)
+  })
+
+  test('escaped backslash before closing quote', t => {
+    const ct = new ContentType('text/plain; c="q\\\\"; d=2')
+    t.assert.strictEqual(ct.parameters.get('c'), 'q\\')
+    t.assert.strictEqual(ct.parameters.get('d'), '2')
+  })
+
+  test('escaped quote inside value', t => {
+    const ct = new ContentType('text/plain; a="x\\";y=1"; b=2')
+    t.assert.strictEqual(ct.parameters.get('a'), 'x";y=1')
+    t.assert.strictEqual(ct.parameters.get('b'), '2')
+  })
+
+  test('unterminated and garbage-suffixed quoted values are invalid', t => {
+    const ct = new ContentType('text/plain; a="x; b=1')
+    t.assert.strictEqual(ct.parameters.get('a'), 'invalid quoted string')
+    t.assert.strictEqual(ct.parameters.has('b'), false)
+    const ct2 = new ContentType('text/plain; a="x"y; b=1')
+    t.assert.strictEqual(ct2.parameters.get('a'), 'invalid quoted string')
+    t.assert.strictEqual(ct2.parameters.get('b'), '1')
+  })
+})
