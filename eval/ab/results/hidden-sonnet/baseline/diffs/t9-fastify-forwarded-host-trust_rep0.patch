diff --git a/test/trust-proxy.test.js b/test/trust-proxy.test.js
index ae7b756..7de42b0 100644
--- a/test/trust-proxy.test.js
+++ b/test/trust-proxy.test.js
@@ -160,3 +160,31 @@ test('trust proxy protocol', async t => {
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxynoprotocol', undefined)
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxyprotocols', 'ipsum, dolor')
 })
+
+test('forwarded host/proto are ignored when the peer is not a trusted proxy', async t => {
+  const cases = [
+    ['10.0.0.1', false],
+    ['127.0.0.1', true],
+    [['10.0.0.1'], false],
+    [(addr) => addr === '10.0.0.1', false],
+    [(addr) => addr === '127.0.0.1', true],
+    [true, true],
+    [1, true]
+  ]
+  for (const [trustProxy, trusted] of cases) {
+    const app = fastify({ trustProxy })
+    app.get('/', (req, reply) => {
+      reply.send({ host: req.host, hostname: req.hostname, protocol: req.protocol })
+    })
+    t.after(() => app.close())
+    const res = await app.inject({
+      url: '/',
+      remoteAddress: '127.0.0.1',
+      headers: { host: 'real.test', 'x-forwarded-host': 'evil.com', 'x-forwarded-proto': 'https' }
+    })
+    const body = res.json()
+    t.assert.strictEqual(body.host, trusted ? 'evil.com' : 'real.test', String(trustProxy))
+    t.assert.strictEqual(body.hostname, trusted ? 'evil.com' : 'real.test', String(trustProxy))
+    t.assert.strictEqual(body.protocol, trusted ? 'https' : 'http', String(trustProxy))
+  }
+})
