+++ b/example-application/test/deleteOrder.test.ts
@@ -0,0 +1,51 @@
+import { buildOrder } from './order-data-factory';
+import { testSetup } from './setup/test-file-setup';
+
+beforeAll(async () => {
+  await testSetup.start({
+    startAPI: true,
+    disableNetConnect: true,
+    includeTokenInHttpClient: true,
+    mockGetUserCalls: true,
+    mockMailerCalls: true,
+  });
+});
+
+beforeEach(() => {
+  testSetup.resetBeforeEach();
+});
+
+afterAll(async () => {
+  // ️️️✅ Best Practice: Clean-up resources after each run
+  testSetup.tearDownTestFile();
+});
+
+describe('DELETE /order/:id', () => {
+  test('When deleting an order, Then it responds 204, the order is gone and others are unaffected', async () => {
+    //Arrange
+    const client = testSetup.getHTTPClient();
+    const {
+      data: { id: orderToDeleteId },
+    } = await client.post('/order', {
+      userId: 1,
+      productId: 2,
+      mode: 'approved',
+    });
+    const {
+      data: { id: otherOrderId },
+    } = await client.post('/order', {
+      userId: 1,
+      productId: 3,
+      mode: 'approved',
+    });
+
+    //Act
+    const deleteResponse = await client.delete(`/order/${orderToDeleteId}`);
+
+    //Assert
+    expect(deleteResponse.status).toBe(204);
+    expect(deleteResponse.data).toBe('');
+    expect((await client.get(`/order/${orderToDeleteId}`)).status).toBe(404);
+    expect((await client.get(`/order/${otherOrderId}`)).status).toBe(200);
+  });
+});
