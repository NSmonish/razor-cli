diff --git a/example-application/test/listOrders.test.ts b/example-application/test/listOrders.test.ts
new file mode 100644
index 0000000..3ad6069
--- /dev/null
+++ b/example-application/test/listOrders.test.ts
@@ -0,0 +1,69 @@
+import nock from 'nock';
+import { buildOrder } from './order-data-factory';
+import { testSetup } from './setup/test-file-setup';
+
+beforeAll(async () => {
+  await testSetup.start({
+    startAPI: true,
+    disableNetConnect: true,
+    includeTokenInHttpClient: true,
+    mockGetUserCalls: true,
+    mockMailerCalls: true,
+  });
+});
+
+beforeEach(() => {
+  testSetup.resetBeforeEach();
+});
+
+afterAll(async () => {
+  testSetup.tearDownTestFile();
+});
+
+const anyStatus = { validateStatus: () => true };
+
+describe('GET /order', () => {
+  test('When listing, Then items are ordered by id ascending and total ignores pagination', async () => {
+    // Arrange
+    nock('http://localhost')
+      .get('/user/424242')
+      .reply(200, { id: '424242', name: 'Jane' })
+      .persist();
+    const ids: number[] = [];
+    for (let i = 0; i < 3; i++) {
+      const { data } = await testSetup
+        .getHTTPClienForArrange()
+        .post('/order', buildOrder({ userId: 424242 }));
+      ids.push(data.id);
+    }
+
+    // Act
+    const response = await testSetup
+      .getHTTPClient()
+      .get('/order?userId=424242&limit=2&offset=1', anyStatus);
+
+    // Assert
+    expect(response.status).toBe(200);
+    expect(response.data.items.map((o: { id: number }) => o.id)).toEqual(
+      ids.slice(1, 3),
+    );
+    expect(response.data.total).toBe(3);
+  });
+
+  test.each([
+    'userId=abc',
+    'userId=1.5',
+    'limit=0',
+    'limit=101',
+    'limit=x',
+    'offset=-1',
+    'offset=1.2',
+    'limit=',
+  ])('When query is %s, Then responds 400', async (query) => {
+    const response = await testSetup
+      .getHTTPClient()
+      .get(`/order?${query}`, anyStatus);
+
+    expect(response.status).toBe(400);
+  });
+});
