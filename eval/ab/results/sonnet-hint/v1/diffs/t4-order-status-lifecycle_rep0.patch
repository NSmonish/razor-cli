diff --git a/example-application/test/orderStatus.test.ts b/example-application/test/orderStatus.test.ts
new file mode 100644
index 0000000..45e42ad
--- /dev/null
+++ b/example-application/test/orderStatus.test.ts
@@ -0,0 +1,63 @@
+import { testSetup } from './setup/test-file-setup';
+
+beforeAll(async () => {
+  await testSetup.start({
+    startAPI: true,
+    disableNetConnect: true,
+    includeTokenInHttpClient: true,
+    mockGetUserCalls: true,
+    mockMailerCalls: true,
+  });
+});
+
+beforeEach(() => {
+  testSetup.resetBeforeEach();
+});
+
+afterAll(async () => {
+  testSetup.tearDownTestFile();
+});
+
+const addOrder = async (extra = {}) => {
+  const { data } = await testSetup
+    .getHTTPClient()
+    .post('/order', { userId: 1, productId: 2, mode: 'approved', ...extra });
+  return data.id as number;
+};
+
+const patch = (id: number | string, body: unknown) =>
+  testSetup.getHTTPClient().patch(`/order/${id}/status`, body);
+
+describe('PATCH /order/:id/status', () => {
+  test('New order starts as processing even if the body says otherwise', async () => {
+    const id = await addOrder({ status: 'delivered' });
+    const { data } = await testSetup.getHTTPClient().get(`/order/${id}`);
+    expect(data.status).toBe('processing');
+  });
+
+  test('Allowed transition returns 200 with the updated order', async () => {
+    const id = await addOrder();
+    const response = await patch(id, { status: 'shipped' });
+    expect(response.status).toBe(200);
+    expect(response.data).toMatchObject({ id, status: 'shipped' });
+    const { data } = await testSetup.getHTTPClient().get(`/order/${id}`);
+    expect(data.status).toBe('shipped');
+  });
+
+  test('Disallowed transition returns 409 and keeps the status', async () => {
+    const id = await addOrder();
+    const response = await patch(id, { status: 'delivered' });
+    expect(response.status).toBe(409);
+    const { data } = await testSetup.getHTTPClient().get(`/order/${id}`);
+    expect(data.status).toBe('processing');
+  });
+
+  test.each([{ status: 'bogus' }, {}])('Invalid status %j returns 400', async (body) => {
+    const id = await addOrder();
+    expect((await patch(id, body)).status).toBe(400);
+  });
+
+  test('Unknown order returns 404', async () => {
+    expect((await patch(999999, { status: 'shipped' })).status).toBe(404);
+  });
+});
