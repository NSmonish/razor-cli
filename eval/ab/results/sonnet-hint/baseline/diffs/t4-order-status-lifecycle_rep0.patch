@@ -54,6 +57,60 @@ module.exports.addOrder = async function (newOrder) {
   return DBResponse;
 };
 
+const ALLOWED_STATUS_TRANSITIONS = {
+  processing: ['shipped', 'cancelled'],
+  shipped: ['delivered'],
+  delivered: ['returned'],
+  cancelled: [],
+  returned: [],
+};
+
+module.exports.updateOrderStatus = async function (id, newStatus) {
+  if (
+    typeof newStatus !== 'string' ||
+    !Object.prototype.hasOwnProperty.call(ALLOWED_STATUS_TRANSITIONS, newStatus)
+  ) {
+    throw new AppError('invalid-status', `Invalid status`, 400);
+  }
+
+  const repository = new OrderRepository();
+  const notFound = () =>
+    new AppError('order-not-found', `The order ${id} doesnt exist`, 404);
+
+  if (!/^\d+$/.test(String(id))) {
+    throw notFound();
+  }
+  const order = await repository.getOrderById(id);
+  if (!order) {
+    throw notFound();
+  }
+
+  const from = order.status;
+  const invalidTransition = () =>
+    new AppError(
+      'invalid-status-transition',
+      `Cannot change order status from ${from} to ${newStatus}`,
+      409,
+    );
+  if (!ALLOWED_STATUS_TRANSITIONS[from]?.includes(newStatus)) {
+    throw invalidTransition();
+  }
+
+  // Conditional update, so concurrent changes can't both succeed
+  const updated = await repository.updateStatus(id, from, newStatus);
+  if (!updated) {
+    throw invalidTransition();
+  }
+
+  await new MessageQueueClient().publish(
+    'order.events',
+    'order.events.status-changed',
+    { orderId: updated.id, from, to: newStatus },
+  );
+
+  return updated;
+};
+
 module.exports.deleteOrder = async function (id) {
   return await new OrderRepository().deleteOrder(id);
 };
