+const INT32_MAX = 2147483647;
+
+module.exports.listOrders = async function ({ userId, limit, offset }) {
+  // A user id outside the DB integer range can't match any order
+  if (userId !== undefined && Math.abs(userId) > INT32_MAX) {
+    return { items: [], total: 0 };
+  }
+  return await new OrderRepository().listOrders({ userId, limit, offset });
+};
