diff --git a/test/schema-false.test.js b/test/schema-false.test.js
new file mode 100644
index 0000000..a8a1a9c
--- /dev/null
+++ b/test/schema-false.test.js
@@ -0,0 +1,82 @@
+'use strict'
+
+const { test } = require('node:test')
+const Fastify = require('..')
+
+const parts = [
+  ['body', { method: 'POST', url: '/', payload: { a: 1 } }],
+  ['querystring', { method: 'GET', url: '/?a=1' }],
+  ['query', { method: 'GET', url: '/?a=1' }],
+  ['params', { method: 'GET', url: '/x' }],
+  ['headers', { method: 'GET', url: '/', headers: { a: '1' } }]
+]
+
+for (const [part, req] of parts) {
+  test(`false ${part} schema rejects every request`, async (t) => {
+    const fastify = Fastify()
+    let called = false
+    fastify.route({
+      method: req.method,
+      url: part === 'params' ? '/:id' : '/',
+      schema: { [part]: false },
+      handler (request, reply) { called = true; reply.send('ok') }
+    })
+    const res = await fastify.inject(req)
+    t.assert.strictEqual(res.statusCode, 400)
+    t.assert.strictEqual(called, false)
+  })
+
+  test(`custom validatorCompiler receives false ${part} schema`, async (t) => {
+    const fastify = Fastify()
+    const seen = []
+    fastify.setValidatorCompiler(({ schema, httpPart }) => {
+      seen.push([schema, httpPart])
+      return () => true
+    })
+    fastify.route({
+      method: req.method,
+      url: part === 'params' ? '/:id' : '/',
+      schema: { [part]: false },
+      handler (request, reply) { reply.send('ok') }
+    })
+    await fastify.ready()
+    t.assert.ok(seen.length > 0)
+    for (const entry of seen) {
+      t.assert.deepStrictEqual(entry, [false, part === 'query' ? 'querystring' : part])
+    }
+  })
+
+  test(`null ${part} schema fails ready`, async (t) => {
+    const fastify = Fastify()
+    fastify.route({
+      method: req.method,
+      url: part === 'params' ? '/:id' : '/',
+      schema: { [part]: null },
+      handler (request, reply) { reply.send('ok') }
+    })
+    await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_SCH_VALIDATION_BUILD' })
+  })
+}
+
+test('undefined schema still warns, false does not', async (t) => {
+  const warnings = []
+  const onWarning = (w) => { if (w.code === 'FSTWRN001') warnings.push(w.message) }
+  process.on('warning', onWarning)
+  t.after(() => process.removeListener('warning', onWarning))
+
+  const fastify = Fastify()
+  fastify.get('/a', { schema: { body: undefined } }, async () => 'ok')
+  fastify.get('/b', { schema: { querystring: false } }, async () => 'ok')
+  await fastify.ready()
+  await new Promise(resolve => setImmediate(resolve))
+  t.assert.ok(warnings.some(m => m.includes('body')))
+  t.assert.ok(!warnings.some(m => m.includes('querystring')))
+})
+
+test('query and querystring together still throw', async (t) => {
+  const fastify = Fastify()
+  fastify.get('/', {
+    schema: { query: false, querystring: { type: 'object' } }
+  }, async () => 'ok')
+  await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_SCH_DUPLICATE' })
+})
