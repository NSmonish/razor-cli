diff --git a/test/schema-boolean-false.test.js b/test/schema-boolean-false.test.js
new file mode 100644
index 0000000..90943f4
--- /dev/null
+++ b/test/schema-boolean-false.test.js
@@ -0,0 +1,59 @@
+'use strict'
+
+const { test } = require('node:test')
+const Fastify = require('..')
+
+const parts = ['body', 'querystring', 'query', 'params', 'headers']
+
+for (const part of parts) {
+  test(`schema.${part} = false rejects every request`, async (t) => {
+    t.plan(2)
+    const fastify = Fastify()
+    fastify.post('/:id', { schema: { [part]: false } }, async () => {
+      t.assert.fail('handler must not run')
+    })
+
+    const res = await fastify.inject({ method: 'POST', url: '/1', payload: { a: 1 } })
+    t.assert.strictEqual(res.statusCode, 400)
+    t.assert.strictEqual(res.json().code, 'FST_ERR_VALIDATION')
+  })
+
+  test(`custom validatorCompiler receives false for ${part}`, async (t) => {
+    const seen = []
+    const fastify = Fastify()
+    fastify.setValidatorCompiler(({ schema, httpPart }) => {
+      seen.push([httpPart, schema])
+      return () => true
+    })
+    fastify.post('/:id', { schema: { [part]: false } }, async () => 'ok')
+    await fastify.ready()
+    t.assert.deepStrictEqual(seen, [[part === 'query' ? 'querystring' : part, false]])
+  })
+
+  test(`null schema.${part} fails ready()`, async (t) => {
+    const fastify = Fastify()
+    fastify.post('/:id', { schema: { [part]: null } }, async () => 'ok')
+    await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_SCH_VALIDATION_BUILD' })
+  })
+}
+
+test('query and querystring together still throw, even when false', async (t) => {
+  const fastify = Fastify()
+  fastify.get('/', { schema: { query: false, querystring: {} } }, async () => 'ok')
+  await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_SCH_DUPLICATE' })
+})
+
+test('FSTWRN001 is emitted for undefined schemas but not for false', async (t) => {
+  const warnings = []
+  const onWarning = (w) => { if (w.code === 'FSTWRN001') warnings.push(w.message) }
+  process.on('warning', onWarning)
+  t.after(() => process.removeListener('warning', onWarning))
+
+  const fastify = Fastify()
+  fastify.post('/a', { schema: { body: false } }, async () => 'ok')
+  fastify.post('/b', { schema: { body: undefined } }, async () => 'ok')
+  await fastify.ready()
+  await new Promise(resolve => setImmediate(resolve))
+  t.assert.ok(warnings.length <= 1)
+  t.assert.ok(warnings.every(m => m.includes('/b') || m.includes('body')))
+})
