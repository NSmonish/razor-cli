diff --git a/test/header-schema-case.test.js b/test/header-schema-case.test.js
new file mode 100644
index 0000000..324b4fc
--- /dev/null
+++ b/test/header-schema-case.test.js
@@ -0,0 +1,132 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const Fastify = require('..')
+const { FSTSEC002 } = require('../lib/warnings')
+
+async function status (fastify, headers) {
+  const res = await fastify.inject({ method: 'GET', url: '/', headers })
+  return res.statusCode
+}
+
+function build (headers) {
+  const fastify = Fastify()
+  fastify.get('/', { schema: { headers } }, async () => 'ok')
+  return fastify
+}
+
+test('dependencies array form is case-insensitive', async t => {
+  const headers = {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+    dependencies: { 'X-Admin': ['X-Admin-Token'] }
+  }
+  const copy = structuredClone(headers)
+  const fastify = build(headers)
+  t.assert.strictEqual(await status(fastify, { 'x-admin': 'true' }), 400)
+  t.assert.strictEqual(await status(fastify, { 'x-admin': 'true', 'x-admin-token': 'server-secret' }), 200)
+  t.assert.strictEqual(await status(fastify, {}), 200)
+  t.assert.deepStrictEqual(headers, copy)
+})
+
+test('dependencies subschema form, dependentRequired, dependentSchemas', async t => {
+  const f1 = build({
+    type: 'object',
+    dependencies: { 'X-A': { required: ['X-B'], properties: { 'X-B': { const: '1' } } } }
+  })
+  t.assert.strictEqual(await status(f1, { 'x-a': '1' }), 400)
+  t.assert.strictEqual(await status(f1, { 'x-a': '1', 'x-b': '2' }), 400)
+  t.assert.strictEqual(await status(f1, { 'x-a': '1', 'x-b': '1' }), 200)
+})
+
+test('dependentRequired and dependentSchemas are lowercased', async t => {
+  // Ajv (draft-07) does not know these keywords, so capture them with custom ones
+  const seen = {}
+  const fastify = Fastify({
+    ajv: {
+      plugins: [ajv => {
+        for (const keyword of ['dependentRequired', 'dependentSchemas']) {
+          ajv.addKeyword({ keyword, schemaType: 'object', validate: (schema) => { seen[keyword] = schema; return true } })
+        }
+      }]
+    }
+  })
+  const headers = {
+    type: 'object',
+    dependentRequired: { 'X-A': ['X-B'] },
+    dependentSchemas: { 'X-C': { required: ['X-D'], properties: { 'X-D': { type: 'string' } } } }
+  }
+  const copy = structuredClone(headers)
+  fastify.get('/', { schema: { headers } }, async () => 'ok')
+  await fastify.ready()
+  const res = await fastify.inject('/')
+  t.assert.strictEqual(res.statusCode, 200)
+  t.assert.deepStrictEqual(seen, {
+    dependentRequired: { 'x-a': ['x-b'] },
+    dependentSchemas: { 'x-c': { required: ['x-d'], properties: { 'x-d': { type: 'string' } } } }
+  })
+  t.assert.deepStrictEqual(headers, copy)
+})
+
+test('nested subschemas and local $ref definitions', async t => {
+  const f1 = build({
+    type: 'object',
+    allOf: [{ required: ['X-A'] }],
+    anyOf: [{ properties: { 'X-B': { const: '1' } }, required: ['X-B'] }, { required: ['X-C'] }],
+    if: { required: ['X-D'] },
+    then: { required: ['X-E'] }
+  })
+  t.assert.strictEqual(await status(f1, { 'x-a': '1', 'x-c': '1' }), 200)
+  t.assert.strictEqual(await status(f1, { 'x-c': '1' }), 400)
+  t.assert.strictEqual(await status(f1, { 'x-a': '1', 'x-b': '2' }), 400)
+  t.assert.strictEqual(await status(f1, { 'x-a': '1', 'x-c': '1', 'x-d': '1' }), 400)
+
+  const defs = {
+    type: 'object',
+    allOf: [{ $ref: '#/definitions/admin' }],
+    definitions: {
+      admin: {
+        type: 'object',
+        properties: { 'X-Admin': { const: 'true' } },
+        required: ['X-Admin'],
+        dependencies: { 'X-Admin': ['X-Token'] }
+      }
+    }
+  }
+  const copy = structuredClone(defs)
+  const f2 = build(defs)
+  t.assert.strictEqual(await status(f2, {}), 400)
+  t.assert.strictEqual(await status(f2, { 'x-admin': 'true' }), 400)
+  t.assert.strictEqual(await status(f2, { 'x-admin': 'true', 'x-token': 'a' }), 200)
+  t.assert.deepStrictEqual(defs, copy)
+})
+
+test('FSTSEC002 is emitted for external $ref only', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+
+  const fastify = Fastify({ exposeHeadRoutes: false })
+  fastify.addSchema({
+    $id: 'http://example.com/admin-headers',
+    type: 'object',
+    properties: { 'x-admin': { const: 'true' } }
+  })
+  fastify.get('/ext', {
+    schema: { headers: { $ref: 'http://example.com/admin-headers#' } }
+  }, async () => 'ok')
+  fastify.get('/local', {
+    schema: {
+      headers: {
+        type: 'object',
+        allOf: [{ $ref: '#/definitions/a' }],
+        definitions: { a: { type: 'object', required: ['X-A'] } }
+      }
+    }
+  }, async () => 'ok')
+  fastify.get('/inline', { schema: { headers: { type: 'object', properties: { 'X-A': { type: 'string' } } } } }, async () => 'ok')
+  await fastify.ready()
+
+  t.assert.strictEqual(spy.callCount(), 1)
+  t.assert.deepStrictEqual(spy.calls[0].arguments, ['GET', '/ext', 'http://example.com/admin-headers#'])
+})
