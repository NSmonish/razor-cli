+const { FSTWRN001, FSTSEC002 } = require('./warnings')
+
+const SUBSCHEMA_KEYWORDS = ['allOf', 'anyOf', 'oneOf']
+const SUBSCHEMA_MAP_KEYWORDS = ['definitions', '$defs']
+const SINGLE_SUBSCHEMA_KEYWORDS = ['not', 'if', 'then', 'else']
+
+function lowerCaseNames (names) {
+  return names.map(n => typeof n === 'string' ? n.toLowerCase() : n)
+}
+
+function isObject (v) {
+  return v !== null && typeof v === 'object' && !Array.isArray(v)
+}
+
+/**
+ * Returns a copy of a headers JSON schema where every header name that is
+ * matched against the (lowercased) incoming headers is lowercased.
+ * The input schema is never mutated. Only subschemas that apply to the headers
+ * object itself are visited; `onExternalRef` is called with every `$ref` that
+ * is not local and therefore can not be normalized.
+ */
+function lowerCaseHeadersSchema (schema, onExternalRef, seen = new WeakMap()) {
+  if (!isObject(schema)) {
+    return schema
+  }
+  if (seen.has(schema)) {
+    return seen.get(schema)
+  }
+  const out = Object.assign({}, schema)
+  seen.set(schema, out)
+  const visit = (s) => lowerCaseHeadersSchema(s, onExternalRef, seen)
+
+  if (typeof schema.$ref === 'string' && !schema.$ref.startsWith('#')) {
+    onExternalRef(schema.$ref)
+  }
+
+  if (isObject(schema.properties)) {
+    out.properties = {}
+    for (const k of Object.keys(schema.properties)) {
+      out.properties[k.toLowerCase()] = schema.properties[k]
+    }
+  }
+  if (Array.isArray(schema.required)) {
+    out.required = lowerCaseNames(schema.required)
+  }
+
+  for (const key of ['dependencies', 'dependentRequired', 'dependentSchemas']) {
+    if (!isObject(schema[key])) continue
+    out[key] = {}
+    for (const k of Object.keys(schema[key])) {
+      const v = schema[key][k]
+      out[key][k.toLowerCase()] = Array.isArray(v) ? lowerCaseNames(v) : visit(v)
+    }
+  }
+
+  for (const key of SUBSCHEMA_KEYWORDS) {
+    if (Array.isArray(schema[key])) {
+      out[key] = schema[key].map(visit)
+    }
+  }
+  for (const key of SINGLE_SUBSCHEMA_KEYWORDS) {
+    if (isObject(schema[key])) {
+      out[key] = visit(schema[key])
+    }
+  }
+  for (const key of SUBSCHEMA_MAP_KEYWORDS) {
+    if (isObject(schema[key])) {
+      out[key] = {}
+      for (const k of Object.keys(schema[key])) {
+        out[key][k] = visit(schema[key][k])
+      }
+    }
+  }
+  return out
+}
 
