diff --git a/test/headers-schema-case.test.js b/test/headers-schema-case.test.js
new file mode 100644
index 0000000..677ff31
--- /dev/null
+++ b/test/headers-schema-case.test.js
@@ -0,0 +1,86 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const nextVocabulary = require('ajv/dist/vocabularies/next').default
+const Fastify = require('..')
+const { FSTSEC002 } = require('../lib/warnings')
+
+async function status (schema, headers, setup) {
+  // the default validator compiler is kept so that headers get normalized;
+  // draft 2019 dependentRequired/dependentSchemas are added as a vocabulary
+  const fastify = Fastify({
+    exposeHeadRoutes: false,
+    ajv: { plugins: [(ajv) => ajv.addVocabulary(nextVocabulary)] }
+  })
+  if (setup) setup(fastify)
+  fastify.get('/', { schema: { headers: schema } }, async () => 'ok')
+  const res = await fastify.inject({ url: '/', headers })
+  await fastify.close()
+  return res.statusCode
+}
+
+const cases = {
+  'dependencies array': (n) => ({
+    type: 'object',
+    properties: { [n('X-Admin')]: { const: 'true' }, [n('X-Admin-Token')]: { const: 'secret' } },
+    dependencies: { [n('X-Admin')]: [n('X-Admin-Token')] }
+  }),
+  'dependencies subschema': (n) => ({
+    type: 'object',
+    dependencies: { [n('X-Admin')]: { required: [n('X-Admin-Token')] } }
+  }),
+  dependentRequired: (n) => ({
+    type: 'object',
+    dependentRequired: { [n('X-Admin')]: [n('X-Admin-Token')] }
+  }),
+  dependentSchemas: (n) => ({
+    type: 'object',
+    dependentSchemas: { [n('X-Admin')]: { required: [n('X-Admin-Token')] } }
+  }),
+  'nested allOf': (n) => ({
+    type: 'object',
+    allOf: [{ properties: { [n('X-Admin')]: { const: 'true' } }, dependentRequired: { [n('X-Admin')]: [n('X-Admin-Token')] } }]
+  }),
+  'local $ref': (n) => ({
+    type: 'object',
+    $ref: '#/definitions/h',
+    definitions: { h: { required: [n('X-Admin')], dependencies: { [n('X-Admin')]: [n('X-Admin-Token')] } } }
+  })
+}
+
+for (const [name, build] of Object.entries(cases)) {
+  test(`canonical-case schema behaves like lowercase: ${name}`, async (t) => {
+    const canonical = build(k => k)
+    const lower = build(k => k.toLowerCase())
+    const copy = JSON.stringify(canonical)
+    for (const headers of [
+      {},
+      { 'x-admin': 'true' },
+      { 'x-admin': 'true', 'x-admin-token': 'secret' },
+      { 'x-admin-token': 'secret' }
+    ]) {
+      t.assert.strictEqual(await status(canonical, headers), await status(lower, headers), JSON.stringify(headers))
+    }
+    t.assert.strictEqual(JSON.stringify(canonical), copy, 'schema not mutated')
+  })
+}
+
+test('dependency trigger is enforced', async (t) => {
+  const schema = cases['dependencies array'](k => k)
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'true' }), 400)
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'true', 'x-admin-token': 'secret' }), 200)
+})
+
+test('external $ref emits FSTSEC002, inline and local do not', async (t) => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+  const shared = { $id: 'http://example.com/admin-headers', type: 'object', properties: { 'x-admin': { type: 'string' } } }
+
+  await status({ $ref: 'http://example.com/admin-headers#' }, {}, f => f.addSchema(shared))
+  t.assert.deepStrictEqual(spy.calls, [{ arguments: ['GET', '/', 'http://example.com/admin-headers#'], result: true }])
+
+  await status({ type: 'object', properties: { 'X-A': { type: 'string' } } }, {})
+  await status({ $ref: '#/definitions/h', definitions: { h: { type: 'object' } } }, {})
+  t.assert.strictEqual(spy.callCount(), 1)
+})
