+const lowerCaseList = list => Array.isArray(list) ? list.map(h => typeof h === 'string' ? h.toLowerCase() : h) : list
+const isObject = v => v !== null && typeof v === 'object' && !Array.isArray(v)
+
+// keywords whose value is a single subschema
+const schemaKeywords = ['not', 'if', 'then', 'else', 'items', 'additionalItems', 'additionalProperties',
+  'unevaluatedProperties', 'unevaluatedItems', 'contains', 'propertyNames']
+// keywords whose value is an array of subschemas
+const schemaArrayKeywords = ['allOf', 'anyOf', 'oneOf', 'prefixItems', 'items']
+// keywords whose value is a map of name -> subschema, names are kept as is
+const schemaMapKeywords = ['definitions', '$defs', 'patternProperties']
+
+// Returns a copy of the headers schema where every header name is lowercased,
+// since node lowercases incoming header names. The original is not mutated.
+function lowerCaseHeadersSchema (root, method, url) {
+  const rootId = typeof root.$id === 'string' ? root.$id.replace(/#$/, '') : null
+  const seen = new WeakMap()
+
+  function isLocalRef (ref) {
+    const base = ref.split('#')[0]
+    return base === '' || (rootId !== null && base === rootId)
+  }
+
+  function walk (schema) {
+    if (!isObject(schema)) return schema
+    if (seen.has(schema)) return seen.get(schema)
+    const out = {}
+    seen.set(schema, out)
+    for (const key of Object.keys(schema)) out[key] = schema[key]
+
+    if (typeof schema.$ref === 'string' && !isLocalRef(schema.$ref)) {
+      FSTSEC002(method, url, schema.$ref)
+    }
+
+    if (Array.isArray(schema.required)) out.required = lowerCaseList(schema.required)
+
+    if (isObject(schema.properties)) {
+      out.properties = {}
+      for (const k of Object.keys(schema.properties)) {
+        out.properties[k.toLowerCase()] = walk(schema.properties[k])
+      }
+    }
+
+    for (const kw of ['dependencies', 'dependentSchemas', 'dependentRequired']) {
+      if (!isObject(schema[kw])) continue
+      out[kw] = {}
+      for (const k of Object.keys(schema[kw])) {
+        const v = schema[kw][k]
+        out[kw][k.toLowerCase()] = Array.isArray(v) ? lowerCaseList(v) : walk(v)
+      }
+    }
+
+    for (const kw of schemaMapKeywords) {
+      if (!isObject(schema[kw])) continue
+      out[kw] = {}
+      for (const k of Object.keys(schema[kw])) out[kw][k] = walk(schema[kw][k])
+    }
+
+    for (const kw of schemaKeywords) {
+      if (isObject(schema[kw])) out[kw] = walk(schema[kw])
+    }
+    for (const kw of schemaArrayKeywords) {
+      if (Array.isArray(schema[kw])) out[kw] = schema[kw].map(walk)
+    }
+    return out
+  }
+
+  return walk(root)
+}
 
