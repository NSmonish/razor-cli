diff --git a/test/headers-case.test.js b/test/headers-case.test.js
new file mode 100644
index 0000000..2e0f719
--- /dev/null
+++ b/test/headers-case.test.js
@@ -0,0 +1,85 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const Fastify = require('..')
+const dependentRequired = require('ajv/dist/vocabularies/validation/dependentRequired').default
+const dependentSchemas = require('ajv/dist/vocabularies/applicator/dependentSchemas').default
+
+// draft-07 Ajv does not know the 2019 dependent* keywords out of the box
+const plugin = ajv => {
+  ajv.addKeyword(dependentRequired)
+  ajv.addKeyword(dependentSchemas)
+}
+const { FSTSEC002 } = require('../lib/warnings')
+
+async function status (schema, headers, addSchemas = []) {
+  const fastify = Fastify({ ajv: { plugins: [plugin], customOptions: { strictTypes: false } } })
+  for (const s of addSchemas) fastify.addSchema(s)
+  fastify.get('/', { schema: { headers: schema } }, async () => 'ok')
+  const res = await fastify.inject({ url: '/', headers })
+  await fastify.close()
+  return res.statusCode
+}
+
+const cases = {
+  dependencies: {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'secret' } },
+    dependencies: { 'X-Admin': ['X-Admin-Token'] }
+  },
+  dependencySubschema: {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'secret' } },
+    dependencies: { 'X-Admin': { required: ['X-Admin-Token'] } }
+  },
+  dependentRequired: {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'secret' } },
+    dependentRequired: { 'X-Admin': ['X-Admin-Token'] }
+  },
+  dependentSchemas: {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' } },
+    dependentSchemas: { 'X-Admin': { required: ['X-Admin-Token'], properties: { 'X-Admin-Token': { const: 'secret' } } } }
+  },
+  nested: {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' } },
+    allOf: [{ properties: { 'X-Admin-Token': { const: 'secret' } } }, { if: { required: ['X-Admin'] }, then: { required: ['X-Admin-Token'] } }]
+  },
+  localRef: {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' } },
+    allOf: [{ $ref: '#/definitions/tok' }],
+    definitions: { tok: { required: ['X-Admin-Token'], properties: { 'X-Admin-Token': { const: 'secret' } } } },
+    dependencies: { 'X-Admin': ['X-Admin-Token'] }
+  }
+}
+
+for (const [name, schema] of Object.entries(cases)) {
+  test(`canonical-case schema enforced: ${name}`, async t => {
+    t.assert.strictEqual(await status(schema, { 'X-Admin': 'true' }), 400)
+    t.assert.strictEqual(await status(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'bad' }), 400)
+    t.assert.strictEqual(await status(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'secret' }), 200)
+  })
+}
+
+test('schema is not mutated', async t => {
+  const schema = JSON.parse(JSON.stringify(cases.localRef))
+  const copy = JSON.parse(JSON.stringify(schema))
+  await status(schema, {})
+  t.assert.deepStrictEqual(schema, copy)
+})
+
+test('external $ref emits FSTSEC002, inline and local do not', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+  const shared = { $id: 'http://example.com/admin-headers', type: 'object', properties: { 'x-a': { type: 'string' } } }
+
+  await status({ type: 'object', properties: { a: { type: 'string' } }, definitions: { d: {} }, allOf: [{ $ref: '#/definitions/d' }] }, {})
+  t.assert.strictEqual(spy.callCount(), 0)
+
+  await status({ $ref: 'http://example.com/admin-headers#' }, {}, [shared])
+  t.assert.deepStrictEqual(spy.calls.filter(c => c.arguments[0] === 'GET'), [{ arguments: ['GET', '/', 'http://example.com/admin-headers#'], result: true }])
+})
