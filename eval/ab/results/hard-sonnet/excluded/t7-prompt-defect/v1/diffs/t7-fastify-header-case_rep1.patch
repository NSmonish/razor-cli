diff --git a/test/header-schema-case.test.js b/test/header-schema-case.test.js
new file mode 100644
index 0000000..a8c7d7d
--- /dev/null
+++ b/test/header-schema-case.test.js
@@ -0,0 +1,87 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const Fastify = require('..')
+const { FSTSEC002 } = require('../lib/warnings')
+
+const depPlugin = ajv => {
+  ajv.addKeyword(require('ajv/dist/vocabularies/validation/dependentRequired').default)
+  ajv.addKeyword(require('ajv/dist/vocabularies/applicator/dependentSchemas').default)
+}
+
+async function status (schema, headers, setup) {
+  const fastify = Fastify({ ajv: { plugins: [depPlugin] } })
+  if (setup) setup(fastify)
+  fastify.get('/', { schema: { headers: schema } }, async () => ({ ok: true }))
+  const res = await fastify.inject({ url: '/', headers })
+  await fastify.close()
+  return res.statusCode
+}
+
+const adminProps = { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } }
+
+test('dependencies array form is lowercased', async t => {
+  const schema = { type: 'object', properties: adminProps, dependencies: { 'X-Admin': ['X-Admin-Token'] } }
+  t.assert.strictEqual(await status(schema, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await status(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }), 200)
+  t.assert.strictEqual(await status(schema, {}), 200)
+})
+
+test('dependentRequired is lowercased', async t => {
+  const schema = { type: 'object', properties: adminProps, dependentRequired: { 'X-Admin': ['X-Admin-Token'] } }
+  t.assert.strictEqual(await status(schema, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await status(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }), 200)
+})
+
+test('dependentSchemas and dependencies subschema form are lowercased', async t => {
+  const sub = { required: ['X-Admin-Token'], properties: { 'X-Admin-Token': { const: 'server-secret' } } }
+  for (const key of ['dependentSchemas', 'dependencies']) {
+    const schema = { type: 'object', properties: { 'X-Admin': { const: 'true' } }, [key]: { 'X-Admin': sub } }
+    t.assert.strictEqual(await status(schema, { 'X-Admin': 'true' }), 400)
+    t.assert.strictEqual(await status(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'wrong' }), 400)
+    t.assert.strictEqual(await status(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }), 200)
+  }
+})
+
+test('nested subschemas and local $ref definitions are lowercased', async t => {
+  const nested = { type: 'object', allOf: [{ required: ['X-Token'], properties: { 'X-Token': { const: 'a' } } }] }
+  t.assert.strictEqual(await status(nested, {}), 400)
+  t.assert.strictEqual(await status(nested, { 'X-Token': 'b' }), 400)
+  t.assert.strictEqual(await status(nested, { 'X-Token': 'a' }), 200)
+
+  const ref = {
+    type: 'object',
+    $ref: '#/definitions/h',
+    definitions: { h: { type: 'object', required: ['X-Token'], properties: { 'X-Token': { const: 'a' } } } }
+  }
+  const warn = spyWarning(FSTSEC002)
+  t.after(warn.restore)
+  t.assert.strictEqual(await status(ref, {}), 400)
+  t.assert.strictEqual(await status(ref, { 'X-Token': 'a' }), 200)
+  t.assert.strictEqual(warn.callCount(), 0)
+})
+
+test('does not mutate the user schema', async t => {
+  const schema = {
+    type: 'object',
+    required: ['X-Admin'],
+    properties: adminProps,
+    dependencies: { 'X-Admin': ['X-Admin-Token'] },
+    allOf: [{ required: ['X-Admin-Token'] }]
+  }
+  const copy = JSON.parse(JSON.stringify(schema))
+  await status(schema, {})
+  t.assert.deepStrictEqual(JSON.parse(JSON.stringify(schema)), copy)
+})
+
+test('external shared $ref emits FSTSEC002', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+  const fastify = Fastify({ exposeHeadRoutes: false })
+  fastify.addSchema({ $id: 'shared', type: 'object', properties: { 'X-A': { type: 'string' } } })
+  fastify.get('/ext', { schema: { headers: { allOf: [{ $ref: 'shared#' }] } } }, async () => 'ok')
+  await fastify.ready()
+  t.assert.strictEqual(spy.callCount(), 1)
+  t.assert.deepStrictEqual(spy.calls[0].arguments, ['GET', '/ext', 'shared'])
+})
