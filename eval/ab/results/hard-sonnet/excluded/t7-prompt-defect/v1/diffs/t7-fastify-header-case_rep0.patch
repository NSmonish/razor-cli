+// keywords whose value is a single subschema
+const SUBSCHEMA_KEYWORDS = [
+  'additionalProperties', 'additionalItems', 'contains', 'not', 'if', 'then', 'else',
+  'propertyNames', 'unevaluatedProperties', 'unevaluatedItems', 'contentSchema'
+]
+// keywords whose value is an array of subschemas
+const SUBSCHEMA_ARRAY_KEYWORDS = ['allOf', 'anyOf', 'oneOf', 'prefixItems']
+// keywords whose value is a map of name -> subschema (names are not header names)
+const SUBSCHEMA_MAP_KEYWORDS = ['patternProperties', '$defs', 'definitions']
+
+/**
+ * Returns a copy of a headers schema where every header name is lowercased,
+ * at any depth. The input is never mutated.
+ * Warns (FSTSEC002) about references to external schemas, which cannot be rewritten.
+ */
+function lowercaseHeaderSchema (rootSchema, method, url) {
+  const warned = new Set()
+  const rootId = typeof rootSchema.$id === 'string' ? rootSchema.$id : undefined
+
+  function checkRef (ref) {
+    if (typeof ref !== 'string' || ref.startsWith('#')) return
+    const hash = ref.indexOf('#')
+    const id = hash === -1 ? ref : ref.slice(0, hash)
+    if (id === '' || id === rootId || warned.has(id)) return
+    warned.add(id)
+    FSTSEC002(method, url, id)
+  }
+
+  function walk (schema) {
+    if (!isPlainObject(schema)) return schema
+    const out = {}
+    for (const key of Object.keys(schema)) {
+      const value = schema[key]
+      if (key === '$ref') {
+        checkRef(value)
+        out[key] = value
+      } else if (key === 'required') {
+        out[key] = lowerStrings(value)
+      } else if (key === 'properties' && isPlainObject(value)) {
+        out[key] = {}
+        for (const k of Object.keys(value)) out[key][k.toLowerCase()] = walk(value[k])
+      } else if ((key === 'dependencies' || key === 'dependentSchemas') && isPlainObject(value)) {
+        out[key] = {}
+        for (const k of Object.keys(value)) {
+          out[key][k.toLowerCase()] = Array.isArray(value[k]) ? lowerStrings(value[k]) : walk(value[k])
+        }
+      } else if (key === 'dependentRequired' && isPlainObject(value)) {
+        out[key] = {}
+        for (const k of Object.keys(value)) out[key][k.toLowerCase()] = lowerStrings(value[k])
+      } else if (SUBSCHEMA_MAP_KEYWORDS.includes(key) && isPlainObject(value)) {
+        out[key] = {}
+        for (const k of Object.keys(value)) out[key][k] = walk(value[k])
+      } else if (SUBSCHEMA_ARRAY_KEYWORDS.includes(key) && Array.isArray(value)) {
+        out[key] = value.map(walk)
+      } else if (key === 'items') {
+        out[key] = Array.isArray(value) ? value.map(walk) : walk(value)
+      } else if (SUBSCHEMA_KEYWORDS.includes(key)) {
+        out[key] = walk(value)
+      } else {
+        out[key] = value
+      }
+    }
+    return out
+  }
+
+  return walk(rootSchema)
+}
 
