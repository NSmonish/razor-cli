diff --git a/test/schema-header-case.test.js b/test/schema-header-case.test.js
new file mode 100644
index 0000000..d26a050
--- /dev/null
+++ b/test/schema-header-case.test.js
@@ -0,0 +1,100 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const Fastify = require('..')
+const { FSTSEC002 } = require('../lib/warnings')
+const { compileSchemasForValidation } = require('../lib/validation')
+
+async function inject (schema, headers) {
+  const fastify = Fastify()
+  fastify.get('/', { schema: { headers: schema } }, async () => 'ok')
+  const res = await fastify.inject({ url: '/', headers })
+  return res.statusCode
+}
+
+const canonical = {
+  type: 'object',
+  properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+  dependencies: { 'X-Admin': ['X-Admin-Token'] }
+}
+
+test('dependencies array form is lowercased', async t => {
+  t.assert.strictEqual(await inject(canonical, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await inject(canonical, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }), 200)
+  t.assert.strictEqual(await inject(canonical, {}), 200)
+})
+
+// the default Ajv is draft-07 and does not know the 2019-09 keywords,
+// so check what is handed to the compiler directly
+function compiled (headers) {
+  let received
+  compileSchemasForValidation(
+    { schema: { headers }, config: { method: 'GET', url: '/' } },
+    ({ schema }) => { received = schema },
+    false
+  )
+  return received
+}
+
+test('dependentRequired and dependentSchemas are lowercased', t => {
+  const out = compiled({
+    type: 'object',
+    dependentRequired: { 'X-Admin': ['X-Admin-Token'] },
+    dependentSchemas: { 'X-Foo': { required: ['X-Bar'], properties: { 'X-Bar': { const: 'b' } } } }
+  })
+  t.assert.deepStrictEqual(out, {
+    type: 'object',
+    dependentRequired: { 'x-admin': ['x-admin-token'] },
+    dependentSchemas: { 'x-foo': { required: ['x-bar'], properties: { 'x-bar': { const: 'b' } } } }
+  })
+})
+
+test('dependencies subschema form is lowercased', async t => {
+  const schema = {
+    type: 'object',
+    properties: { 'X-Admin': { type: 'string' } },
+    dependencies: { 'X-Admin': { required: ['X-Admin-Token'], properties: { 'X-Admin-Token': { const: 'secret' } } } }
+  }
+  t.assert.strictEqual(await inject(schema, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await inject(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'bad' }), 400)
+  t.assert.strictEqual(await inject(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'secret' }), 200)
+})
+
+test('nested subschemas and local $ref definitions are lowercased', async t => {
+  const schema = {
+    type: 'object',
+    allOf: [{ required: ['X-Foo'], properties: { 'X-Foo': { const: 'a' } } }],
+    anyOf: [{ $ref: '#/definitions/bar' }],
+    definitions: { bar: { required: ['X-Bar'], properties: { 'X-Bar': { const: 'b' } } } }
+  }
+  t.assert.strictEqual(await inject(schema, { 'X-Foo': 'a' }), 400)
+  t.assert.strictEqual(await inject(schema, { 'X-Bar': 'b' }), 400)
+  t.assert.strictEqual(await inject(schema, { 'X-Foo': 'a', 'X-Bar': 'x' }), 400)
+  t.assert.strictEqual(await inject(schema, { 'X-Foo': 'a', 'X-Bar': 'b' }), 200)
+})
+
+test('user schema is not mutated', async t => {
+  const schema = JSON.parse(JSON.stringify(canonical))
+  schema.allOf = [{ required: ['X-A'], properties: { 'X-A': {} } }]
+  const copy = JSON.parse(JSON.stringify(schema))
+  await inject(schema, {})
+  t.assert.deepStrictEqual(schema, copy)
+})
+
+test('FSTSEC002 for external $ref only', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+
+  const fastify = Fastify({ exposeHeadRoutes: false })
+  fastify.addSchema({ $id: 'shared', type: 'object', properties: { 'X-A': { type: 'string' } } })
+  fastify.get('/ext', { schema: { headers: { $ref: 'shared#' } } }, async () => 'ok')
+  fastify.get('/local', {
+    schema: { headers: { type: 'object', allOf: [{ $ref: '#/definitions/a' }], definitions: { a: { type: 'object' } } } }
+  }, async () => 'ok')
+  fastify.get('/inline', { schema: { headers: canonical } }, async () => 'ok')
+  await fastify.ready()
+
+  t.assert.strictEqual(spy.callCount(), 1)
+  t.assert.deepStrictEqual(spy.calls[0].arguments, ['GET', '/ext', 'shared'])
+})
