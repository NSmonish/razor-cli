diff --git a/test/header-schema-case.test.js b/test/header-schema-case.test.js
new file mode 100644
index 0000000..20cacfd
--- /dev/null
+++ b/test/header-schema-case.test.js
@@ -0,0 +1,103 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const Fastify = require('..')
+const { FSTSEC002 } = require('../lib/warnings')
+
+const canonical = () => ({
+  type: 'object',
+  properties: {
+    'X-Admin': { const: 'true' },
+    'X-Admin-Token': { const: 'server-secret' }
+  }
+})
+
+async function run (schema, headers) {
+  const fastify = Fastify()
+  fastify.get('/', { schema: { headers: schema } }, async () => 'ok')
+  const res = await fastify.inject({ url: '/', headers })
+  return res.statusCode
+}
+
+test('dependencies array form is lowercased', async t => {
+  const schema = { ...canonical(), dependencies: { 'X-Admin': ['X-Admin-Token'] } }
+  t.assert.strictEqual(await run(schema, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await run(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }), 200)
+})
+
+test('dependencies subschema form is lowercased', async t => {
+  const schema = { ...canonical(), dependencies: { 'X-Admin': { required: ['X-Admin-Token'] } } }
+  t.assert.strictEqual(await run(schema, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await run(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }), 200)
+})
+
+test('dependentRequired and dependentSchemas are lowercased', t => {
+  const { compileSchemasForValidation } = require('../lib/validation')
+  const { kSchemaHeaders } = require('../lib/symbols')
+  const schema = {
+    type: 'object',
+    properties: { 'X-Admin': { type: 'string' } },
+    dependentRequired: { 'X-Admin': ['X-Admin-Token'] },
+    dependentSchemas: { 'X-Admin': { required: ['X-Other'], properties: { 'X-Other': { type: 'string' } } } }
+  }
+  const copy = structuredClone(schema)
+  const context = { schema: { headers: schema }, config: { method: 'GET', url: '/' } }
+  compileSchemasForValidation(context, ({ schema }) => schema, false)
+  t.assert.deepStrictEqual(context[kSchemaHeaders], {
+    type: 'object',
+    properties: { 'x-admin': { type: 'string' } },
+    dependentRequired: { 'x-admin': ['x-admin-token'] },
+    dependentSchemas: { 'x-admin': { required: ['x-other'], properties: { 'x-other': { type: 'string' } } } }
+  })
+  t.assert.deepStrictEqual(schema, copy)
+})
+
+test('nested subschemas and local $ref definitions are lowercased', async t => {
+  const nested = {
+    type: 'object',
+    allOf: [{ properties: { 'X-Admin': { const: 'true' } }, required: ['X-Admin'] }]
+  }
+  t.assert.strictEqual(await run(nested, {}), 400)
+  t.assert.strictEqual(await run(nested, { 'X-Admin': 'true' }), 200)
+
+  const ref = {
+    type: 'object',
+    definitions: { admin: { type: 'object', properties: { 'X-Admin': { const: 'true' } }, required: ['X-Admin'] } },
+    $ref: '#/definitions/admin'
+  }
+  t.assert.strictEqual(await run(ref, {}), 400)
+  t.assert.strictEqual(await run(ref, { 'X-Admin': 'true' }), 200)
+})
+
+test('user schema is not mutated', async t => {
+  const schema = {
+    ...canonical(),
+    required: ['X-Admin'],
+    dependencies: { 'X-Admin': ['X-Admin-Token'] },
+    allOf: [{ properties: { 'X-Foo': { type: 'string' } } }]
+  }
+  const copy = structuredClone(schema)
+  await run(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' })
+  t.assert.deepStrictEqual(schema, copy)
+})
+
+test('FSTSEC002 is emitted for external $ref only', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+
+  const fastify = Fastify({ exposeHeadRoutes: false })
+  fastify.addSchema({ $id: 'shared', type: 'object', properties: { 'x-a': { type: 'string' } } })
+  fastify.get('/ext', { schema: { headers: { $ref: 'shared#' } } }, async () => 'ok')
+  fastify.get('/nested', { schema: { headers: { type: 'object', properties: { h: { $ref: 'shared#/properties/x-a' } } } } }, async () => 'ok')
+  fastify.get('/local', {
+    schema: { headers: { type: 'object', definitions: { a: { type: 'string' } }, properties: { 'x-b': { $ref: '#/definitions/a' } } } }
+  }, async () => 'ok')
+  fastify.get('/inline', { schema: { headers: canonical() } }, async () => 'ok')
+  await fastify.ready()
+
+  t.assert.deepStrictEqual(spy.calls.map(c => c.arguments), [
+    ['GET', '/ext', 'shared'],
+    ['GET', '/nested', 'shared']
+  ])
+})
