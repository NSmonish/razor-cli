diff --git a/test/schema-headers-case.test.js b/test/schema-headers-case.test.js
new file mode 100644
index 0000000..5a82bed
--- /dev/null
+++ b/test/schema-headers-case.test.js
@@ -0,0 +1,93 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const Fastify = require('..')
+const { FSTSEC002 } = require('../lib/warnings')
+
+async function status (schema, headers, ajvPlugin) {
+  const fastify = Fastify(ajvPlugin ? { ajv: { plugins: [ajvPlugin] } } : {})
+  fastify.get('/', { schema: { headers: schema } }, async () => 'ok')
+  const res = await fastify.inject({ url: '/', headers })
+  return res.statusCode
+}
+
+const admin = { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } }
+
+test('dependencies array form is lowercased', async t => {
+  const schema = { type: 'object', properties: admin, dependencies: { 'X-Admin': ['X-Admin-Token'] } }
+  const copy = structuredClone(schema)
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'true' }), 400)
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'true', 'x-admin-token': 'server-secret' }), 200)
+  t.assert.deepStrictEqual(schema, copy)
+})
+
+test('dependencies subschema form is lowercased', async t => {
+  const schema = {
+    type: 'object',
+    properties: admin,
+    dependencies: { 'X-Admin': { required: ['X-Admin-Token'] } }
+  }
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'true' }), 400)
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'true', 'x-admin-token': 'server-secret' }), 200)
+})
+
+test('dependentRequired and dependentSchemas are lowercased', async t => {
+  const a = { type: 'object', properties: admin, dependentRequired: { 'X-Admin': ['X-Admin-Token'] } }
+  const b = { type: 'object', properties: admin, dependentSchemas: { 'X-Admin': { required: ['X-Admin-Token'] } } }
+  const plugin = ajv => {
+    ajv.addKeyword(require('ajv/dist/vocabularies/validation/dependentRequired').default)
+    ajv.addKeyword(require('ajv/dist/vocabularies/applicator/dependentSchemas').default)
+  }
+  for (const schema of [a, b]) {
+    t.assert.strictEqual(await status(schema, { 'x-admin': 'true' }, plugin), 400)
+    t.assert.strictEqual(await status(schema, { 'x-admin': 'true', 'x-admin-token': 'server-secret' }, plugin), 200)
+  }
+})
+
+test('nested subschemas are lowercased', async t => {
+  const schema = {
+    type: 'object',
+    allOf: [{ properties: { 'X-Admin': { const: 'true' } }, required: ['X-Admin'] }],
+    anyOf: [{ if: { required: ['X-A'] }, then: { required: ['X-B'] } }]
+  }
+  t.assert.strictEqual(await status(schema, {}), 400)
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'false' }), 400)
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'true' }), 200)
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'true', 'x-a': '1' }), 400)
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'true', 'x-a': '1', 'x-b': '1' }), 200)
+})
+
+test('local $ref definitions are lowercased without warning', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+  const schema = {
+    type: 'object',
+    $ref: '#/definitions/h',
+    definitions: {
+      h: { type: 'object', properties: { 'X-Admin': { const: 'true' } }, required: ['X-Admin'] }
+    }
+  }
+  const copy = structuredClone(schema)
+  t.assert.strictEqual(await status(schema, {}), 400)
+  t.assert.strictEqual(await status(schema, { 'x-admin': 'true' }), 200)
+  t.assert.deepStrictEqual(schema, copy)
+  t.assert.strictEqual(spy.callCount(), 0)
+})
+
+test('inline schema does not emit FSTSEC002', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+  await status({ type: 'object', properties: { 'X-A': { type: 'string' } } }, {})
+  t.assert.strictEqual(spy.callCount(), 0)
+})
+
+test('external shared $ref emits FSTSEC002', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+  const fastify = Fastify()
+  fastify.addSchema({ $id: 'shared', type: 'object', properties: { 'x-a': { type: 'string' } } })
+  fastify.get('/ext', { exposeHeadRoute: false, schema: { headers: { type: 'object', allOf: [{ $ref: 'shared#' }] } } }, async () => 'ok')
+  await fastify.ready()
+  t.assert.deepStrictEqual(spy.calls, [{ arguments: ['GET', '/ext', 'shared'], result: true }])
+})
