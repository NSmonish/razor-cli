+function lowerCaseNames (names) {
+  return Array.isArray(names) ? names.map(n => typeof n === 'string' ? n.toLowerCase() : n) : names
+}
+
+/**
+ * Returns a copy of the headers schema where every header name is lowercased
+ * (properties, required, dependencies, dependentRequired, dependentSchemas),
+ * including nested subschemas and local definitions. The input is not mutated.
+ * External `$ref`s cannot be normalized and are collected in `externalRefs`.
+ */
+function lowerCaseHeaderNames (schema, externalRefs, seen = new WeakMap()) {
+  if (Array.isArray(schema)) {
+    return schema.map(s => lowerCaseHeaderNames(s, externalRefs, seen))
+  }
+  if (!isPlainObject(schema)) {
+    return schema
+  }
+  if (seen.has(schema)) {
+    return seen.get(schema)
+  }
+  const out = {}
+  seen.set(schema, out)
+
+  for (const key of Object.keys(schema)) {
+    const value = schema[key]
+    if (key === '$ref') {
+      if (typeof value === 'string' && !value.startsWith('#')) {
+        externalRefs.add(value.split('#')[0])
+      }
+      out[key] = value
+    } else if (key === 'required') {
+      out[key] = lowerCaseNames(value)
+    } else if (key === 'dependentRequired') {
+      out[key] = lowerCaseMap(value, v => lowerCaseNames(v))
+    } else if (key === 'dependencies') {
+      out[key] = lowerCaseMap(value, v => Array.isArray(v)
+        ? lowerCaseNames(v)
+        : lowerCaseHeaderNames(v, externalRefs, seen))
+    } else if (PROPERTY_MAP_KEYWORDS.has(key)) {
+      out[key] = lowerCaseMap(value, v => lowerCaseHeaderNames(v, externalRefs, seen))
+    } else if (SCHEMA_MAP_KEYWORDS.has(key)) {
+      out[key] = mapValues(value, v => lowerCaseHeaderNames(v, externalRefs, seen))
+    } else if (DATA_KEYWORDS.has(key)) {
+      out[key] = value
+    } else if (SCHEMA_KEYWORDS.has(key) || SCHEMA_ARRAY_KEYWORDS.has(key) || isPlainObject(value)) {
+      // also covers unknown keywords/containers a local $ref may point to
+      out[key] = lowerCaseHeaderNames(value, externalRefs, seen)
+    } else {
+      out[key] = value
+    }
+  }
+  return out
+}
+
+function lowerCaseMap (map, fn) {
+  if (!isPlainObject(map)) {
+    return map
+  }
+  const out = {}
+  for (const k of Object.keys(map)) {
+    out[k.toLowerCase()] = fn(map[k])
+  }
+  return out
+}
+
+function mapValues (map, fn) {
+  if (!isPlainObject(map)) {
+    return map
+  }
+  const out = {}
+  for (const k of Object.keys(map)) {
+    out[k] = fn(map[k])
+  }
+  return out
+}
 
