diff --git a/test/schema-headers-case.test.js b/test/schema-headers-case.test.js
new file mode 100644
index 0000000..27531cb
--- /dev/null
+++ b/test/schema-headers-case.test.js
@@ -0,0 +1,141 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const Fastify = require('..')
+const { FSTSEC002 } = require('../lib/warnings')
+const { compileSchemasForValidation } = require('../lib/validation')
+
+async function status (schema, headers, setup) {
+  const fastify = Fastify()
+  if (setup) setup(fastify)
+  fastify.get('/', { schema: { headers: schema } }, async () => 'ok')
+  const res = await fastify.inject({ url: '/', headers })
+  return res.statusCode
+}
+
+const canonical = {
+  type: 'object',
+  properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+  dependencies: { 'X-Admin': ['X-Admin-Token'] }
+}
+
+test('dependencies (array form) is lowercased', async t => {
+  t.assert.strictEqual(await status(canonical, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await status(canonical, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }), 200)
+  t.assert.strictEqual(await status(canonical, {}), 200)
+})
+
+test('dependencies subschema form is lowercased', async t => {
+  const schema = {
+    type: 'object',
+    dependencies: { 'X-Admin': { required: ['X-Token'], properties: { 'X-Token': { const: 'ok' } } } }
+  }
+  t.assert.strictEqual(await status(schema, { 'X-Admin': '1' }), 400)
+  t.assert.strictEqual(await status(schema, { 'X-Admin': '1', 'X-Token': 'bad' }), 400)
+  t.assert.strictEqual(await status(schema, { 'X-Admin': '1', 'X-Token': 'ok' }), 200)
+  t.assert.strictEqual(await status(schema, {}), 200)
+})
+
+test('dependentRequired and dependentSchemas are lowercased', t => {
+  // the default ajv draft does not implement these keywords, so inspect the compiled schema
+  let compiled
+  const schema = {
+    headers: {
+      type: 'object',
+      dependentRequired: { 'X-Admin': ['X-Admin-Token'] },
+      dependentSchemas: { 'X-Foo': { required: ['X-Bar'], properties: { 'X-Bar': {} } } }
+    }
+  }
+  const copy = JSON.parse(JSON.stringify(schema))
+  compileSchemasForValidation({ schema, config: {} }, ({ schema }) => { compiled = schema }, false)
+  t.assert.deepStrictEqual(compiled, {
+    type: 'object',
+    dependentRequired: { 'x-admin': ['x-admin-token'] },
+    dependentSchemas: { 'x-foo': { required: ['x-bar'], properties: { 'x-bar': {} } } }
+  })
+  t.assert.deepStrictEqual(schema, copy)
+})
+
+test('nested subschemas are lowercased', async t => {
+  const schema = {
+    type: 'object',
+    allOf: [{ required: ['X-A'], properties: { 'X-A': { const: '1' } } }],
+    anyOf: [{ required: ['X-B'] }, { required: ['X-C'] }],
+    if: { required: ['X-D'] },
+    then: { required: ['X-E'] }
+  }
+  t.assert.strictEqual(await status(schema, { 'X-A': '1', 'X-B': 'x' }), 200)
+  t.assert.strictEqual(await status(schema, { 'X-A': '2', 'X-B': 'x' }), 400)
+  t.assert.strictEqual(await status(schema, { 'X-A': '1' }), 400)
+  t.assert.strictEqual(await status(schema, { 'X-A': '1', 'X-C': 'x', 'X-D': 'x' }), 400)
+  t.assert.strictEqual(await status(schema, { 'X-A': '1', 'X-C': 'x', 'X-D': 'x', 'X-E': 'x' }), 200)
+})
+
+test('local $ref definitions are lowercased, without warning', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+  const schema = {
+    type: 'object',
+    $ref: '#/definitions/auth',
+    definitions: {
+      auth: {
+        type: 'object',
+        properties: { 'X-Admin': { const: 'true' } },
+        required: ['X-Admin'],
+        dependencies: { 'X-Admin': ['X-Admin-Token'] }
+      }
+    }
+  }
+  t.assert.strictEqual(await status(schema, {}), 400)
+  t.assert.strictEqual(await status(schema, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await status(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'a' }), 200)
+  t.assert.strictEqual(spy.callCount(), 0)
+})
+
+test('local $ref pointing at a header property is lowercased', async t => {
+  const schema = {
+    type: 'object',
+    properties: { 'X-A': { const: '1' }, 'X-B': { $ref: '#/properties/X-A' } }
+  }
+  t.assert.strictEqual(await status(schema, { 'X-B': '2' }), 400)
+  t.assert.strictEqual(await status(schema, { 'X-B': '1' }), 200)
+})
+
+test('canonical schema behaves like the lowercase one', async t => {
+  const lower = {
+    type: 'object',
+    properties: { 'x-admin': { const: 'true' }, 'x-admin-token': { const: 'server-secret' } },
+    dependencies: { 'x-admin': ['x-admin-token'] }
+  }
+  for (const headers of [{}, { 'X-Admin': 'true' }, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }, { 'X-Admin-Token': 'x' }]) {
+    t.assert.strictEqual(await status(canonical, headers), await status(lower, headers))
+  }
+})
+
+test('the user supplied schema is not mutated', async t => {
+  const schema = JSON.parse(JSON.stringify({
+    ...canonical,
+    required: ['X-Admin'],
+    allOf: [{ properties: { 'X-Z': {} }, required: ['X-Z'] }],
+    definitions: { a: { properties: { 'X-Y': {} } } }
+  }))
+  const copy = JSON.parse(JSON.stringify(schema))
+  await status(schema, {})
+  t.assert.deepStrictEqual(schema, copy)
+})
+
+test('external shared $ref emits FSTSEC002', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+  const fastify = Fastify({ exposeHeadRoutes: false })
+  fastify.addSchema({
+    $id: 'shared',
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' } }
+  })
+  fastify.get('/ext', { schema: { headers: { $ref: 'shared#' } } }, async () => 'ok')
+  fastify.get('/inline', { schema: { headers: canonical } }, async () => 'ok')
+  await fastify.ready()
+  t.assert.deepStrictEqual(spy.calls, [{ arguments: ['GET', '/ext', 'shared'], result: true }])
+})
