+const { FSTWRN001, FSTSEC002 } = require('./warnings')
+
+// keywords whose value is a single subschema
+const SUBSCHEMA_KEYWORDS = [
+  'additionalProperties', 'additionalItems', 'unevaluatedProperties', 'unevaluatedItems',
+  'items', 'contains', 'not', 'if', 'then', 'else', 'propertyNames'
+]
+// keywords whose value is an array of subschemas
+const SUBSCHEMA_ARRAY_KEYWORDS = ['allOf', 'anyOf', 'oneOf', 'prefixItems', 'items']
+// keywords whose value is a map of arbitrary names to subschemas
+const SUBSCHEMA_MAP_KEYWORDS = ['definitions', '$defs', 'patternProperties']
+// keywords whose value is a map of header names to subschemas (or arrays of names)
+const HEADER_NAME_MAP_KEYWORDS = ['properties', 'dependencies', 'dependentRequired', 'dependentSchemas']
+
+function isPlainObject (o) {
+  return o !== null && typeof o === 'object' && Object.getPrototypeOf(o) === Object.prototype
+}
+
+function lowerCaseRef (ref) {
+  // lowercase the header name segments of a local JSON pointer
+  const parts = ref.split('/')
+  for (let i = 2; i < parts.length; i++) {
+    if (HEADER_NAME_MAP_KEYWORDS.includes(parts[i - 1])) {
+      parts[i] = parts[i].toLowerCase()
+    }
+  }
+  return parts.join('/')
+}
+
+/**
+ * Builds a copy of a headers schema where every header name is lowercased,
+ * as node.js lowercases the incoming header names. The input is not mutated.
+ * Emits FSTSEC002 for references to external schemas, which cannot be normalized.
+ */
+function lowerCaseHeadersSchema (headers, method, url) {
+  const rootId = typeof headers.$id === 'string' ? headers.$id : undefined
+  const warned = new Set()
+
+  function walk (schema) {
+    if (!isPlainObject(schema)) return schema
+    const out = {}
+    for (const key of Object.keys(schema)) {
+      const value = schema[key]
+      if (key === '$ref' && typeof value === 'string') {
+        const hash = value.indexOf('#')
+        const base = hash === -1 ? value : value.slice(0, hash)
+        if (base === '' || base === rootId) {
+          out[key] = hash === -1 ? value : base + lowerCaseRef(value.slice(hash))
+        } else {
+          out[key] = value
+          if (!warned.has(base)) {
+            warned.add(base)
+            FSTSEC002(method, url, base)
+          }
+        }
+      } else if (key === 'required' && Array.isArray(value)) {
+        out[key] = value.map(h => typeof h === 'string' ? h.toLowerCase() : h)
+      } else if (HEADER_NAME_MAP_KEYWORDS.includes(key) && isPlainObject(value)) {
+        const map = {}
+        for (const name of Object.keys(value)) {
+          const entry = value[name]
+          map[name.toLowerCase()] = Array.isArray(entry)
+            ? entry.map(h => typeof h === 'string' ? h.toLowerCase() : h)
+            : walk(entry)
+        }
+        out[key] = map
+      } else if (SUBSCHEMA_MAP_KEYWORDS.includes(key) && isPlainObject(value)) {
+        const map = {}
+        for (const name of Object.keys(value)) {
+          map[name] = walk(value[name])
+        }
+        out[key] = map
+      } else if (SUBSCHEMA_ARRAY_KEYWORDS.includes(key) && Array.isArray(value)) {
+        out[key] = value.map(walk)
+      } else if (SUBSCHEMA_KEYWORDS.includes(key)) {
+        out[key] = walk(value)
+      } else {
+        out[key] = value
+      }
+    }
+    return out
+  }
+
+  return walk(headers)
+}
 
