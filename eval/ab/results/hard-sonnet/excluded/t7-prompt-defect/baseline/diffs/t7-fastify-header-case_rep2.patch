+  function lowerKeys (obj) {
+    const out = {}
+    for (const k of Object.keys(obj)) {
+      out[k.toLowerCase()] = Array.isArray(obj[k]) ? lowerAll(obj[k]) : obj[k]
+    }
+    return out
+  }
+
+  visit(root)
+  for (const id of external) FSTSEC002(method, url, id)
+  return root
+}
