+// Returns a lowercased deep copy of a headers schema; the original is untouched.
+// Only positions describing the headers object itself are rewritten (root,
+// combinators, conditionals, dependencies and local $ref targets).
+function normalizeHeadersSchema (headers, method, url) {
+  const root = cloneSchema(headers)
+  const seen = new Set()
+  const external = new Set()
+  const rootId = typeof root.$id === 'string' ? root.$id : undefined
+
+  const visit = (schema) => {
+    if (!isPlainObject(schema) || seen.has(schema)) return
+    seen.add(schema)
+
+    if (Array.isArray(schema.required)) schema.required = lowerAll(schema.required)
+    if (isPlainObject(schema.properties)) {
+      const props = {}
+      for (const k of Object.keys(schema.properties)) props[k.toLowerCase()] = schema.properties[k]
+      schema.properties = props
+    }
+    if (isPlainObject(schema.dependentRequired)) {
+      schema.dependentRequired = lowerKeys(schema.dependentRequired)
+    }
+    for (const kw of ['dependencies', 'dependentSchemas']) {
+      if (isPlainObject(schema[kw])) {
+        schema[kw] = lowerKeys(schema[kw])
+        for (const k of Object.keys(schema[kw])) visit(schema[kw][k])
+      }
+    }
+    for (const kw of ['allOf', 'anyOf', 'oneOf']) {
+      if (Array.isArray(schema[kw])) schema[kw].forEach(visit)
+    }
+    for (const kw of ['not', 'if', 'then', 'else']) visit(schema[kw])
