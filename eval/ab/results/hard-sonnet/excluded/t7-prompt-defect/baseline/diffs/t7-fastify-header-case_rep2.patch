diff --git a/test/schema-headers-case.test.js b/test/schema-headers-case.test.js
new file mode 100644
index 0000000..674ca6e
--- /dev/null
+++ b/test/schema-headers-case.test.js
@@ -0,0 +1,110 @@
+'use strict'
+
+const { test } = require('node:test')
+const Fastify = require('..')
+const { FSTSEC002 } = require('../lib/warnings')
+
+async function status (fastify, headers) {
+  const res = await fastify.inject({ method: 'GET', url: '/', headers })
+  return res.statusCode
+}
+
+function build (headers, setup, opts) {
+  const fastify = Fastify(opts)
+  if (setup) setup(fastify)
+  fastify.get('/', { schema: { headers } }, async () => 'ok')
+  return fastify
+}
+
+const upper = {
+  type: 'object',
+  properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+  dependencies: { 'X-Admin': ['X-Admin-Token'] }
+}
+
+test('dependencies array form is lowercased', async t => {
+  const fastify = build(upper)
+  t.assert.strictEqual(await status(fastify, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await status(fastify, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }), 200)
+  t.assert.strictEqual(await status(fastify, {}), 200)
+})
+
+test('dependencies subschema form is lowercased', async t => {
+  const fastify = build({ type: 'object', dependencies: { 'X-A': { required: ['X-B'] } } })
+  t.assert.strictEqual(await status(fastify, { 'x-a': '1' }), 400)
+  t.assert.strictEqual(await status(fastify, { 'x-a': '1', 'x-b': '1' }), 200)
+})
+
+test('dependentRequired and dependentSchemas are lowercased', async t => {
+  const schemas = [
+    { type: 'object', dependentRequired: { 'X-A': ['X-B'] } },
+    { type: 'object', dependentSchemas: { 'X-A': { required: ['X-B'] } } }
+  ]
+  // draft-07 Ajv lacks these 2019-09 keywords; map them onto `dependencies`
+  const opts = {
+    ajv: {
+      plugins: [ajv => {
+        ajv.addKeyword({ keyword: 'dependentRequired', macro: schema => ({ dependencies: schema }) })
+        ajv.addKeyword({ keyword: 'dependentSchemas', macro: schema => ({ dependencies: schema }) })
+      }]
+    }
+  }
+  for (const s of schemas) {
+    const fastify = build(s, null, opts)
+    t.assert.strictEqual(await status(fastify, { 'x-a': '1' }), 400)
+    t.assert.strictEqual(await status(fastify, { 'x-a': '1', 'x-b': '1' }), 200)
+  }
+})
+
+test('nested subschemas and local $ref definitions are lowercased', async t => {
+  const schemas = [
+    { type: 'object', allOf: [{ required: ['X-A'] }], anyOf: [{ properties: { 'X-A': { const: '1' } } }] },
+    { type: 'object', $ref: '#/definitions/h', definitions: { h: { required: ['X-A'], properties: { 'X-A': { const: '1' } } } } },
+    { type: 'object', if: { required: ['X-A'] }, then: { required: ['X-B'] } }
+  ]
+  for (const s of schemas) {
+    const fastify = build(s)
+    t.assert.strictEqual(await status(fastify, {}), s.if ? 200 : 400)
+    t.assert.strictEqual(await status(fastify, { 'x-a': '1' }), s.if ? 400 : 200)
+    t.assert.strictEqual(await status(fastify, { 'x-a': '1', 'x-b': '1' }), 200)
+  }
+})
+
+test('the user schema is not mutated', async t => {
+  const schema = {
+    type: 'object',
+    required: ['X-Admin'],
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+    dependencies: { 'X-Admin': ['X-Admin-Token'] },
+    allOf: [{ required: ['X-Admin'] }]
+  }
+  const copy = JSON.parse(JSON.stringify(schema))
+  const fastify = build(schema)
+  await fastify.ready()
+  t.assert.deepStrictEqual(schema, copy)
+})
+
+test('FSTSEC002 is emitted for external $ref only', async t => {
+  const calls = []
+  const orig = FSTSEC002.emit
+  process.on('warning', function listener (w) {
+    if (w.code === 'FSTSEC002') calls.push(w.message)
+  })
+  t.after(() => { FSTSEC002.emit = orig })
+
+  const shared = { $id: 'shared', type: 'object', required: ['X-A'] }
+  const external = build({ $ref: 'shared#' }, f => f.addSchema(shared))
+  await external.ready()
+  await new Promise(resolve => setImmediate(resolve))
+  // one per route: GET and its automatic HEAD sibling
+  t.assert.strictEqual(calls.length, 2)
+  t.assert.ok(calls.some(m => /GET/.test(m) && /shared/.test(m)))
+
+  calls.length = 0
+  const local = build({ type: 'object', $ref: '#/definitions/h', definitions: { h: { required: ['x-a'] } } })
+  await local.ready()
+  const inline = build(upper)
+  await inline.ready()
+  await new Promise(resolve => setImmediate(resolve))
+  t.assert.strictEqual(calls.length, 0)
+})
