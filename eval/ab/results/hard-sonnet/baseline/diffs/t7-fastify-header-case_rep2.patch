 | <a id="FSTWRN003">FSTWRN003</a> | The `%s` plugin mixes async and callback styles, which may lead to unhandled rejections. | Do not mix async and callback style. | [#6011](https://github.com/fastify/fastify/pull/6011) |
 
+### Fastify Security Codes
+
+| Code | Description | How to solve |
+| ---- | ----------- | ------------ |
+| <a id="FSTSEC002">FSTSEC002</a> | A route's `headers` schema uses a `$ref` to an external shared schema (added with `addSchema`). Header names inside it cannot be lowercased, so canonical-case names will not match incoming headers. | Use lowercase header names in the shared schema, or inline it. |
+
 ### Fastify Deprecation Codes
 
 Deprecation codes are supported by the Node.js CLI options:
diff --git a/lib/header-schema.js b/lib/header-schema.js
new file mode 100644
index 0000000..0ed4431
--- /dev/null
+++ b/lib/header-schema.js
@@ -0,0 +1,127 @@
+'use strict'
+
+// Node.js lowercases incoming header names, so every position of a headers
+// schema that names a header has to be lowercased too.
+// https://datatracker.ietf.org/doc/html/rfc2616#section-4.2
+
+// keywords whose value is a map of "name -> schema" (names are not headers)
+const schemaMapKeywords = ['definitions', '$defs', 'patternProperties', 'dependentSchemas']
+// keywords whose value is a schema
+const schemaKeywords = [
+  'additionalProperties', 'unevaluatedProperties', 'additionalItems', 'unevaluatedItems',
+  'contains', 'not', 'if', 'then', 'else', 'propertyNames'
+]
+// keywords whose value is an array of schemas
+const schemaArrayKeywords = ['allOf', 'anyOf', 'oneOf', 'prefixItems']
+
+function isPlainObject (value) {
+  return value !== null && typeof value === 'object' &&
+    Object.getPrototypeOf(value) === Object.prototype
+}
+
+function lowerList (list) {
+  return list.map(h => typeof h === 'string' ? h.toLowerCase() : h)
+}
+
+function collectIds (node, ids, seen) {
+  if (node === null || typeof node !== 'object' || seen.has(node)) return
+  seen.add(node)
+  if (typeof node.$id === 'string') ids.add(node.$id.split('#')[0])
+  for (const key of Object.keys(node)) {
+    // `$id` could also be the name of a header
+    collectIds(node[key], ids, seen)
+  }
+}
+
+function lowerRefPointer (ref) {
+  const hash = ref.indexOf('#')
+  const prefix = ref.slice(0, hash)
+  const segments = ref.slice(hash).split('/')
+  for (let i = 1; i < segments.length; i++) {
+    if (segments[i - 1] === 'properties') segments[i] = segments[i].toLowerCase()
+  }
+  return prefix + segments.join('/')
+}
+
+/**
+ * Returns a copy of `schema` in which every header name is lowercased. The
+ * given schema is never mutated.
+ * `onExternalRef` is called for each `$ref` that points outside of the schema,
+ * as those can not be normalized.
+ */
+function lowerCaseHeadersSchema (schema, onExternalRef) {
+  const ids = new Set()
+  collectIds(schema, ids, new Set())
+  const cache = new Map()
+
+  function isLocalRef (ref) {
+    if (ref.startsWith('#')) return true
+    return ids.has(ref.split('#')[0])
+  }
+
+  function walkSchema (node) {
+    if (Array.isArray(node) || !isPlainObject(node)) return node
+    if (cache.has(node)) return cache.get(node)
+
+    const out = {}
+    cache.set(node, out)
+
+    for (const key of Object.keys(node)) {
+      const value = node[key]
+      if (key === '$ref' && typeof value === 'string') {
+        if (isLocalRef(value)) {
+          out[key] = value.includes('#/') ? lowerRefPointer(value) : value
+        } else {
+          onExternalRef(value)
+          out[key] = value
+        }
+      } else if (key === 'properties' && isPlainObject(value)) {
+        const props = {}
+        for (const name of Object.keys(value)) {
+          props[name.toLowerCase()] = walkSchema(value[name])
+        }
+        out[key] = props
+      } else if (key === 'required' && Array.isArray(value)) {
+        out[key] = lowerList(value)
+      } else if (key === 'dependentRequired' && isPlainObject(value)) {
+        const deps = {}
+        for (const name of Object.keys(value)) {
+          deps[name.toLowerCase()] = Array.isArray(value[name]) ? lowerList(value[name]) : value[name]
+        }
+        out[key] = deps
+      } else if (key === 'dependencies' && isPlainObject(value)) {
+        const deps = {}
+        for (const name of Object.keys(value)) {
+          const dep = value[name]
+          deps[name.toLowerCase()] = Array.isArray(dep) ? lowerList(dep) : walkSchema(dep)
+        }
+        out[key] = deps
+      } else if (key === 'dependentSchemas' && isPlainObject(value)) {
+        const deps = {}
+        for (const name of Object.keys(value)) {
+          deps[name.toLowerCase()] = walkSchema(value[name])
+        }
+        out[key] = deps
+      } else if (schemaMapKeywords.includes(key) && isPlainObject(value)) {
+        const map = {}
+        for (const name of Object.keys(value)) {
+          map[name] = walkSchema(value[name])
+        }
+        out[key] = map
+      } else if (key === 'items') {
+        out[key] = Array.isArray(value) ? value.map(walkSchema) : walkSchema(value)
+      } else if (schemaArrayKeywords.includes(key) && Array.isArray(value)) {
+        out[key] = value.map(walkSchema)
+      } else if (schemaKeywords.includes(key)) {
+        out[key] = walkSchema(value)
+      } else {
+        out[key] = value
+      }
+    }
+    return out
+  }
+
+  return walkSchema(schema)
+}
+
+module.exports = { lowerCaseHeadersSchema }
