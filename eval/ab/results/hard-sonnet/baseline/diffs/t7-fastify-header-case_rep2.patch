diff --git a/test/header-schema-case.test.js b/test/header-schema-case.test.js
new file mode 100644
index 0000000..45b6236
--- /dev/null
+++ b/test/header-schema-case.test.js
@@ -0,0 +1,114 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const Fastify = require('..')
+const { FSTSEC002 } = require('../lib/warnings')
+
+async function status (fastify, headers) {
+  const res = await fastify.inject({ method: 'GET', url: '/', headers })
+  return res.statusCode
+}
+
+const cases = {
+  dependencies: {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+    dependencies: { 'X-Admin': ['X-Admin-Token'] }
+  },
+  'dependencies subschema': {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+    dependencies: { 'X-Admin': { required: ['X-Admin-Token'] } }
+  },
+  'nested allOf': {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+    allOf: [{ properties: { 'X-Admin': { const: 'true' } }, dependencies: { 'X-Admin': ['X-Admin-Token'] } }]
+  },
+  'local $ref': {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+    allOf: [{ $ref: '#/definitions/guard' }],
+    definitions: {
+      guard: { required: ['X-Admin-Token'], properties: { 'X-Admin-Token': { const: 'server-secret' } } }
+    }
+  }
+}
+
+for (const [name, schema] of Object.entries(cases)) {
+  test(`canonical-case headers schema is enforced: ${name}`, async t => {
+    const copy = structuredClone(schema)
+    const fastify = Fastify()
+    t.after(() => fastify.close())
+    fastify.get('/', { schema: { headers: schema } }, async () => 'ok')
+
+    t.assert.strictEqual(await status(fastify, { 'x-admin': 'true' }), 400)
+    t.assert.strictEqual(await status(fastify, { 'x-admin': 'true', 'x-admin-token': 'server-secret' }), 200)
+    t.assert.strictEqual(await status(fastify, { 'x-admin': 'true', 'x-admin-token': 'wrong' }), 400)
+    t.assert.deepStrictEqual(schema, copy, 'user schema is not mutated')
+  })
+}
+
+test('local $ref into properties follows lowercased names', async t => {
+  const fastify = Fastify()
+  t.after(() => fastify.close())
+  fastify.get('/', {
+    schema: {
+      headers: {
+        type: 'object',
+        properties: { 'X-A': { const: 'a' }, 'X-B': { $ref: '#/properties/X-A' } },
+        required: ['X-B']
+      }
+    }
+  }, async () => 'ok')
+  t.assert.strictEqual(await status(fastify, { 'x-b': 'a' }), 200)
+  t.assert.strictEqual(await status(fastify, { 'x-b': 'b' }), 400)
+})
+
+test('FSTSEC002 is emitted for external $ref only', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+  const fastify = Fastify()
+  t.after(() => fastify.close())
+  fastify.addSchema({
+    $id: 'http://example.com/admin-headers',
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' } }
+  })
+  fastify.get('/ext', {
+    schema: { headers: { allOf: [{ $ref: 'http://example.com/admin-headers#' }] } }
+  }, async () => 'ok')
+  fastify.get('/local', {
+    schema: {
+      headers: {
+        type: 'object',
+        allOf: [{ $ref: '#/definitions/h' }],
+        definitions: { h: { properties: { 'X-A': { type: 'string' } } } }
+      }
+    }
+  }, async () => 'ok')
+  fastify.get('/inline', {
+    schema: { headers: { type: 'object', properties: { 'X-A': { type: 'string' } } } }
+  }, async () => 'ok')
+  await fastify.ready()
+
+  t.assert.strictEqual(spy.callCount(), 1)
+  t.assert.deepStrictEqual(spy.calls[0].arguments, ['GET', '/ext', 'http://example.com/admin-headers#'])
+})
+
+test('lowerCaseHeadersSchema handles draft 2019 dependency keywords', t => {
+  const { lowerCaseHeadersSchema } = require('../lib/header-schema')
+  const schema = {
+    dependentRequired: { 'X-A': ['X-B'] },
+    dependentSchemas: { 'X-A': { required: ['X-C'], properties: { 'X-C': {} } } },
+    $defs: { d: { required: ['X-D'] } }
+  }
+  const copy = structuredClone(schema)
+  t.assert.deepStrictEqual(lowerCaseHeadersSchema(schema, () => {}), {
+    dependentRequired: { 'x-a': ['x-b'] },
+    dependentSchemas: { 'x-a': { required: ['x-c'], properties: { 'x-c': {} } } },
+    $defs: { d: { required: ['x-d'] } }
+  })
+  t.assert.deepStrictEqual(schema, copy)
+})
