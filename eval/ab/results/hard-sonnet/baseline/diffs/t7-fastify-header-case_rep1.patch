+const { FSTWRN001, FSTSEC002 } = require('./warnings')
+
+const schemaMapKeywords = ['properties', 'patternProperties', 'dependentSchemas', 'definitions', '$defs']
+const schemaKeywords = [
+  'additionalProperties', 'additionalItems', 'items', 'contains', 'propertyNames', 'not',
+  'if', 'then', 'else', 'unevaluatedProperties', 'unevaluatedItems'
+]
+const schemaArrayKeywords = ['allOf', 'anyOf', 'oneOf', 'prefixItems', 'items']
+
+function isObject (v) {
+  return v !== null && typeof v === 'object' && !Array.isArray(v)
+}
+
+function lowerCaseList (list) {
+  return list.map(h => typeof h === 'string' ? h.toLowerCase() : h)
+}
+
+function collectIds (schema, ids, seen = new Set()) {
+  if (Array.isArray(schema)) {
+    for (const s of schema) collectIds(s, ids, seen)
+    return ids
+  }
+  if (!isObject(schema) || seen.has(schema)) return ids
+  seen.add(schema)
+  if (typeof schema.$id === 'string') ids.add(schema.$id.replace(/#$/, ''))
+  for (const k of Object.keys(schema)) {
+    if (k === 'const' || k === 'enum' || k === 'default' || k === 'examples') continue
+    collectIds(schema[k], ids, seen)
+  }
+  return ids
+}
+
+// Header names are lowercased by node, so every position of the schema that
+// names a header must be lowercased. Returns a copy; the input is not mutated.
+function lowerCaseHeadersSchema (root, method, url) {
+  const ids = collectIds(root, new Set())
+  const seen = new Map()
+
+  function walk (schema) {
+    if (!isObject(schema)) return schema
+    if (seen.has(schema)) return seen.get(schema)
+    const out = {}
+    seen.set(schema, out)
+    for (const k of Object.keys(schema)) out[k] = schema[k]
+
+    if (typeof schema.$ref === 'string') {
+      const base = schema.$ref.split('#')[0]
+      if (base !== '' && !ids.has(base)) FSTSEC002(method, url, schema.$ref)
+    }
+    if (Array.isArray(schema.required)) out.required = lowerCaseList(schema.required)
+
+    for (const k of schemaMapKeywords) {
+      if (!isObject(schema[k])) continue
+      out[k] = {}
+      for (const name of Object.keys(schema[k])) {
+        out[k][k === 'properties' || k === 'dependentSchemas' ? name.toLowerCase() : name] = walk(schema[k][name])
+      }
+    }
+    for (const k of schemaKeywords) {
+      if (isObject(schema[k])) out[k] = walk(schema[k])
+    }
+    for (const k of schemaArrayKeywords) {
+      if (Array.isArray(schema[k])) out[k] = schema[k].map(walk)
+    }
+    for (const k of ['dependencies', 'dependentRequired']) {
+      if (!isObject(schema[k])) continue
+      out[k] = {}
+      for (const name of Object.keys(schema[k])) {
+        const v = schema[k][name]
+        out[k][name.toLowerCase()] = Array.isArray(v) ? lowerCaseList(v) : walk(v)
+      }
+    }
+    return out
+  }
+
+  return walk(root)
+}
 
