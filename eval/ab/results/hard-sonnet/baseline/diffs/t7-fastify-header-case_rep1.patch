diff --git a/test/header-case-schema.test.js b/test/header-case-schema.test.js
new file mode 100644
index 0000000..539e8f3
--- /dev/null
+++ b/test/header-case-schema.test.js
@@ -0,0 +1,92 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const Fastify = require('..')
+const { lowerCaseHeadersSchema } = require('../lib/validation')
+const { FSTSEC002 } = require('../lib/warnings')
+
+async function status (schema, headers, setup) {
+  const fastify = Fastify()
+  if (setup) setup(fastify)
+  fastify.get('/', { schema: { headers: schema } }, async () => 'ok')
+  const res = await fastify.inject({ url: '/', headers })
+  return res.statusCode
+}
+
+test('dependencies are lowercased and input is not mutated', async t => {
+  const schema = {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+    dependencies: { 'X-Admin': ['X-Admin-Token'] }
+  }
+  const copy = JSON.parse(JSON.stringify(schema))
+  t.assert.strictEqual(await status(schema, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await status(schema, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }), 200)
+  t.assert.strictEqual(await status(schema, {}), 200)
+  t.assert.deepStrictEqual(schema, copy)
+})
+
+test('dependencies subschema form', async t => {
+  const schema = {
+    type: 'object',
+    properties: { 'X-A': { type: 'string' }, 'X-B': { type: 'string' } },
+    dependencies: { 'X-A': { required: ['X-B'] } }
+  }
+  t.assert.strictEqual(await status(schema, { 'x-a': '1' }), 400)
+  t.assert.strictEqual(await status(schema, { 'x-a': '1', 'x-b': '1' }), 200)
+})
+
+test('dependentRequired and dependentSchemas are lowercased', async t => {
+  const input = {
+    type: 'object',
+    properties: { 'X-A': { type: 'string' } },
+    dependentRequired: { 'X-A': ['X-B'] },
+    dependentSchemas: { 'X-A': { required: ['X-C'], properties: { 'X-C': {} } } }
+  }
+  const copy = JSON.parse(JSON.stringify(input))
+  const compiled = lowerCaseHeadersSchema(input, 'GET', '/')
+  t.assert.deepStrictEqual(compiled.dependentRequired, { 'x-a': ['x-b'] })
+  t.assert.deepStrictEqual(compiled.dependentSchemas, { 'x-a': { required: ['x-c'], properties: { 'x-c': {} } } })
+  t.assert.deepStrictEqual(input, copy)
+})
+
+test('nested subschemas and local $ref definitions', async t => {
+  const nested = {
+    type: 'object',
+    anyOf: [{ properties: { 'X-One': { const: 'a' } }, required: ['X-One'] }, { required: ['X-Two'] }]
+  }
+  t.assert.strictEqual(await status(nested, { 'x-one': 'a' }), 200)
+  t.assert.strictEqual(await status(nested, {}), 400)
+
+  const ref = {
+    type: 'object',
+    allOf: [{ $ref: '#/definitions/h' }],
+    definitions: { h: { type: 'object', required: ['X-Req'], properties: { 'X-Req': { const: 'y' } } } }
+  }
+  const warn = spyWarning(FSTSEC002)
+  t.after(warn.restore)
+  t.assert.strictEqual(await status(ref, {}), 400)
+  t.assert.strictEqual(await status(ref, { 'x-req': 'n' }), 400)
+  t.assert.strictEqual(await status(ref, { 'x-req': 'y' }), 200)
+  t.assert.strictEqual(warn.callCount(), 0)
+})
+
+test('external $ref emits FSTSEC002', async t => {
+  const warn = spyWarning(FSTSEC002)
+  t.after(warn.restore)
+  const fastify = Fastify({ exposeHeadRoutes: false })
+  fastify.addSchema({
+    $id: 'http://example.com/admin-headers',
+    type: 'object',
+    properties: { 'x-admin': { type: 'string' } }
+  })
+  fastify.get('/ext', {
+    schema: { headers: { type: 'object', properties: { 'X-A': { $ref: 'http://example.com/admin-headers#' } } } }
+  }, async () => 'ok')
+  await fastify.ready()
+  t.assert.deepStrictEqual(warn.calls, [{
+    arguments: ['GET', '/ext', 'http://example.com/admin-headers#'],
+    result: true
+  }])
+})
