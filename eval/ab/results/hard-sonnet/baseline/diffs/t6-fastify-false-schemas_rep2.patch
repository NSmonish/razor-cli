diff --git a/test/schema-boolean.test.js b/test/schema-boolean.test.js
new file mode 100644
index 0000000..028476f
--- /dev/null
+++ b/test/schema-boolean.test.js
@@ -0,0 +1,81 @@
+'use strict'
+
+const { test } = require('node:test')
+const Fastify = require('..')
+
+const parts = [
+  ['body', 'POST', { method: 'POST', url: '/', payload: { a: 1 } }],
+  ['querystring', 'GET', { method: 'GET', url: '/?a=1' }],
+  ['query', 'GET', { method: 'GET', url: '/?a=1' }],
+  ['params', 'GET', { method: 'GET', url: '/x' }],
+  ['headers', 'GET', { method: 'GET', url: '/x' }]
+]
+
+const urlFor = (part) => part === 'params' || part === 'headers' ? '/:id' : '/'
+
+for (const [part, method, inject] of parts) {
+  test(`false ${part} schema rejects with 400 and skips the handler`, async (t) => {
+    const fastify = Fastify()
+    let called = false
+    fastify.route({
+      method,
+      url: urlFor(part),
+      schema: { [part]: false },
+      handler: () => { called = true; return 'ok' }
+    })
+    const res = await fastify.inject(inject)
+    t.assert.strictEqual(res.statusCode, 400)
+    t.assert.strictEqual(called, false)
+  })
+
+  test(`custom validatorCompiler receives false ${part} schema`, async (t) => {
+    const fastify = Fastify()
+    const seen = []
+    fastify.setValidatorCompiler(({ schema, httpPart }) => {
+      seen.push([schema, httpPart])
+      return () => true
+    })
+    fastify.route({
+      method,
+      url: urlFor(part),
+      schema: { [part]: false },
+      handler: () => 'ok'
+    })
+    await fastify.ready()
+    t.assert.ok(seen.length >= 1)
+    for (const entry of seen) {
+      t.assert.deepStrictEqual(entry, [false, part === 'query' ? 'querystring' : part])
+    }
+  })
+
+  test(`null ${part} schema fails ready`, async (t) => {
+    const fastify = Fastify()
+    fastify.route({
+      method,
+      url: urlFor(part),
+      schema: { [part]: null },
+      handler: () => 'ok'
+    })
+    await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_SCH_VALIDATION_BUILD' })
+  })
+}
+
+test('undefined schema still warns, false does not', async (t) => {
+  const warnings = []
+  const onWarning = (w) => warnings.push(w.code)
+  process.on('warning', onWarning)
+  t.after(() => process.removeListener('warning', onWarning))
+
+  const fastify = Fastify()
+  fastify.post('/a', { schema: { body: undefined } }, () => 'ok')
+  fastify.post('/b', { schema: { body: false } }, () => 'ok')
+  await fastify.ready()
+  await new Promise((resolve) => setImmediate(resolve))
+  t.assert.strictEqual(warnings.filter((c) => c === 'FSTWRN001').length, 1)
+})
+
+test('query and querystring together still throw', async (t) => {
+  const fastify = Fastify()
+  fastify.get('/', { schema: { query: false, querystring: {} } }, () => 'ok')
+  await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_SCH_DUPLICATE' })
+})
