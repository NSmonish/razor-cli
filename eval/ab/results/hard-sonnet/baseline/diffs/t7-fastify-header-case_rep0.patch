index 0000000..10fb660
--- /dev/null
+++ b/lib/headers-schema.js
@@ -0,0 +1,115 @@
+'use strict'
+
+const { FSTSEC002 } = require('./warnings')
+
+const subschemaArrayKeywords = ['allOf', 'anyOf', 'oneOf']
+const subschemaKeywords = ['not', 'if', 'then', 'else']
+
+function isObject (v) {
+  return v !== null && typeof v === 'object' && !Array.isArray(v)
+}
+
+function lowerList (list) {
+  return list.map(h => typeof h === 'string' ? h.toLowerCase() : h)
+}
+
+function lowerKeys (obj, mapValue) {
+  const out = {}
+  for (const k of Object.keys(obj)) {
+    out[k.toLowerCase()] = mapValue ? mapValue(obj[k]) : obj[k]
+  }
+  return out
+}
+
+/**
+ * Returns a copy of a headers schema where every header name is lowercased,
+ * in `properties`, `required`, `dependencies`, `dependentRequired` and
+ * `dependentSchemas`, also within nested subschemas and local `$ref` targets.
+ * The given schema is never mutated.
+ * Header-level `$ref`s that point outside of the schema trigger FSTSEC002.
+ */
+function lowerCaseHeadersSchema (root, method, url) {
+  const rootId = typeof root.$id === 'string' ? root.$id.replace(/#$/, '') : null
+  const extraDefs = {}
+  const refCache = new Map()
+  let defCount = 0
+
+  function normalizeRef (ref) {
+    if (rootId && (ref === rootId || ref.startsWith(rootId + '#'))) {
+      ref = '#' + ref.slice(rootId.length + 1)
+      if (ref === '#') return ref
+    }
+    if (ref === '#') return ref
+    if (!ref.startsWith('#')) {
+      FSTSEC002(method, url, ref)
+      return ref
+    }
+    if (!ref.startsWith('#/')) return ref // anchors cannot be resolved
+
+    if (refCache.has(ref)) return refCache.get(ref)
+
+    let target = root
+    for (const raw of ref.slice(2).split('/')) {
+      let segment = raw
+      try { segment = decodeURIComponent(raw) } catch {}
+      segment = segment.replace(/~1/g, '/').replace(/~0/g, '~')
+      if (target === null || typeof target !== 'object' || !Object.hasOwn(target, segment)) {
+        refCache.set(ref, ref)
+        return ref
+      }
+      target = target[segment]
+    }
+    if (!isObject(target)) {
+      refCache.set(ref, ref)
+      return ref
+    }
+
+    const name = `__fastifyHeaders${defCount++}`
+    const newRef = `#/$defs/${name}`
+    refCache.set(ref, newRef)
+    const copy = schemaLevel(target)
+    delete copy.$id
+    delete copy.$anchor
+    extraDefs[name] = copy
+    return newRef
+  }
+
+  function schemaLevel (node) {
+    if (!isObject(node)) return node
+    const out = Object.assign({}, node)
+
+    if (typeof node.$ref === 'string') {
+      out.$ref = normalizeRef(node.$ref)
+    }
+    if (Array.isArray(node.required)) {
+      out.required = lowerList(node.required)
+    }
+    if (isObject(node.properties)) {
+      out.properties = lowerKeys(node.properties)
+    }
+    for (const kw of subschemaArrayKeywords) {
+      if (Array.isArray(node[kw])) out[kw] = node[kw].map(schemaLevel)
+    }
+    for (const kw of subschemaKeywords) {
+      if (isObject(node[kw])) out[kw] = schemaLevel(node[kw])
+    }
+    if (isObject(node.dependencies)) {
+      out.dependencies = lowerKeys(node.dependencies, dep => Array.isArray(dep) ? lowerList(dep) : schemaLevel(dep))
+    }
+    if (isObject(node.dependentRequired)) {
+      out.dependentRequired = lowerKeys(node.dependentRequired, dep => Array.isArray(dep) ? lowerList(dep) : dep)
+    }
+    if (isObject(node.dependentSchemas)) {
+      out.dependentSchemas = lowerKeys(node.dependentSchemas, schemaLevel)
+    }
+    return out
+  }
+
+  const result = schemaLevel(root)
+  if (defCount > 0) {
+    result.$defs = Object.assign({}, root.$defs, extraDefs)
+  }
+  return result
+}
+
+module.exports = { lowerCaseHeadersSchema }
