diff --git a/test/header-schema-case.test.js b/test/header-schema-case.test.js
new file mode 100644
index 0000000..6e49517
--- /dev/null
+++ b/test/header-schema-case.test.js
@@ -0,0 +1,119 @@
+'use strict'
+
+const { test } = require('node:test')
+const { spyWarning } = require('process-warning')
+const Fastify = require('..')
+const { lowerCaseHeadersSchema } = require('../lib/headers-schema')
+const { FSTSEC002 } = require('../lib/warnings')
+
+function build (t, headers, extra) {
+  const fastify = Fastify({ exposeHeadRoutes: false })
+  t.after(() => fastify.close())
+  if (extra) extra(fastify)
+  fastify.get('/', { schema: { headers } }, async () => 'ok')
+  return fastify
+}
+
+async function status (fastify, headers) {
+  const res = await fastify.inject({ method: 'GET', url: '/', headers })
+  return res.statusCode
+}
+
+test('dependencies array form is lowercased', async t => {
+  const headers = {
+    type: 'object',
+    properties: { 'X-Admin': { const: 'true' }, 'X-Admin-Token': { const: 'server-secret' } },
+    dependencies: { 'X-Admin': ['X-Admin-Token'] }
+  }
+  const copy = structuredClone(headers)
+  const fastify = build(t, headers)
+  t.assert.strictEqual(await status(fastify, { 'X-Admin': 'true' }), 400)
+  t.assert.strictEqual(await status(fastify, { 'X-Admin': 'true', 'X-Admin-Token': 'server-secret' }), 200)
+  t.assert.strictEqual(await status(fastify, {}), 200)
+  t.assert.deepStrictEqual(headers, copy)
+})
+
+test('dependencies subschema form is lowercased', async t => {
+  const fastify = build(t, {
+    type: 'object',
+    dependencies: { 'X-Admin': { required: ['X-Admin-Token'], properties: { 'X-Admin-Token': { const: 'a' } } } }
+  })
+  t.assert.strictEqual(await status(fastify, { 'x-admin': '1' }), 400)
+  t.assert.strictEqual(await status(fastify, { 'x-admin': '1', 'x-admin-token': 'b' }), 400)
+  t.assert.strictEqual(await status(fastify, { 'x-admin': '1', 'x-admin-token': 'a' }), 200)
+})
+
+test('dependentRequired and dependentSchemas are lowercased', t => {
+  const headers = {
+    type: 'object',
+    dependentRequired: { 'X-A': ['X-B'] },
+    dependentSchemas: { 'X-C': { required: ['X-D'], properties: { 'X-D': { type: 'string' } } } }
+  }
+  const copy = structuredClone(headers)
+  t.assert.deepStrictEqual(lowerCaseHeadersSchema(headers, 'GET', '/'), {
+    type: 'object',
+    dependentRequired: { 'x-a': ['x-b'] },
+    dependentSchemas: { 'x-c': { required: ['x-d'], properties: { 'x-d': { type: 'string' } } } }
+  })
+  t.assert.deepStrictEqual(headers, copy)
+})
+
+test('nested subschemas are lowercased', async t => {
+  const fastify = build(t, {
+    type: 'object',
+    allOf: [{ required: ['X-A'] }],
+    anyOf: [{ properties: { 'X-B': { const: '1' } }, required: ['X-B'] }, { required: ['X-C'] }],
+    if: { required: ['X-D'] },
+    then: { required: ['X-E'] }
+  })
+  t.assert.strictEqual(await status(fastify, {}), 400)
+  t.assert.strictEqual(await status(fastify, { 'x-a': '1', 'x-b': '2', 'x-c': '1' }), 200)
+  t.assert.strictEqual(await status(fastify, { 'x-a': '1', 'x-b': '1' }), 200)
+  t.assert.strictEqual(await status(fastify, { 'x-a': '1', 'x-b': '1', 'x-d': '1' }), 400)
+  t.assert.strictEqual(await status(fastify, { 'x-a': '1', 'x-b': '1', 'x-d': '1', 'x-e': '1' }), 200)
+})
+
+test('local $ref definitions are lowercased without mutating the schema', async t => {
+  const headers = {
+    type: 'object',
+    allOf: [{ $ref: '#/definitions/admin' }],
+    definitions: {
+      admin: {
+        properties: { 'X-Admin': { const: 'true' } },
+        dependencies: { 'X-Admin': ['X-Admin-Token'] }
+      }
+    }
+  }
+  const copy = structuredClone(headers)
+  const fastify = build(t, headers)
+  t.assert.strictEqual(await status(fastify, { 'x-admin': 'true' }), 400)
+  t.assert.strictEqual(await status(fastify, { 'x-admin': 'false', 'x-admin-token': 'x' }), 400)
+  t.assert.strictEqual(await status(fastify, { 'x-admin': 'true', 'x-admin-token': 'x' }), 200)
+  t.assert.deepStrictEqual(headers, copy)
+})
+
+test('FSTSEC002 is emitted for external $ref, not for inline or local', async t => {
+  const spy = spyWarning(FSTSEC002)
+  t.after(spy.restore)
+
+  const ref = 'http://example.com/admin-headers#'
+  const fastify = build(t, { allOf: [{ $ref: ref }] }, f => {
+    f.addSchema({ $id: 'http://example.com/admin-headers', type: 'object' })
+  })
+  await fastify.ready()
+  t.assert.deepStrictEqual(spy.calls.map(c => c.arguments), [['GET', '/', ref]])
+
+  const f2 = build(t, {
+    type: 'object',
+    properties: { a: { type: 'string' } },
+    allOf: [{ $ref: '#/definitions/d' }],
+    definitions: { d: { type: 'object' } }
+  })
+  await f2.ready()
+  t.assert.strictEqual(spy.callCount(), 1)
+})
+
+test('FSTSEC002 is exported', t => {
+  t.assert.strictEqual(typeof FSTSEC002, 'function')
+  t.assert.strictEqual(FSTSEC002.code, 'FSTSEC002')
+})
