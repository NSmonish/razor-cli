diff --git a/test/false-schema.test.js b/test/false-schema.test.js
new file mode 100644
index 0000000..021fa46
--- /dev/null
+++ b/test/false-schema.test.js
@@ -0,0 +1,60 @@
+'use strict'
+
+const { test } = require('node:test')
+const Fastify = require('..')
+
+for (const [part, opts] of [
+  ['body', { method: 'POST', url: '/x', payload: { a: 1 } }],
+  ['querystring', { method: 'GET', url: '/x?a=1' }],
+  ['query', { method: 'GET', url: '/x?a=1' }],
+  ['params', { method: 'GET', url: '/x' }],
+  ['headers', { method: 'GET', url: '/x' }]
+]) {
+  test(`false ${part} schema rejects every request`, async (t) => {
+    const fastify = Fastify()
+    let called = false
+    fastify.route({
+      method: opts.method,
+      url: part === 'params' ? '/:id' : '/x',
+      schema: { [part]: false },
+      handler: async () => { called = true; return 'ok' }
+    })
+    const res = await fastify.inject(opts)
+    t.assert.strictEqual(res.statusCode, 400)
+    t.assert.strictEqual(called, false)
+  })
+
+  test(`custom validatorCompiler receives false ${part} schema`, async (t) => {
+    const fastify = Fastify()
+    const seen = []
+    fastify.setValidatorCompiler(({ schema, httpPart }) => {
+      seen.push([schema, httpPart])
+      return () => true
+    })
+    fastify.route({
+      method: opts.method,
+      url: part === 'params' ? '/:id' : '/x',
+      schema: { [part]: false },
+      handler: async () => 'ok'
+    })
+    await fastify.ready()
+    t.assert.ok(seen.length >= 1)
+    for (const entry of seen) {
+      t.assert.deepStrictEqual(entry, [false, part === 'query' ? 'querystring' : part])
+    }
+  })
+}
+
+test('null schema fails ready', async (t) => {
+  for (const part of ['body', 'querystring', 'query', 'params', 'headers']) {
+    const fastify = Fastify()
+    fastify.post('/:id', { schema: { [part]: null } }, async () => 'ok')
+    await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_SCH_VALIDATION_BUILD' })
+  }
+})
+
+test('query and querystring together still throw, even when false', async (t) => {
+  const fastify = Fastify()
+  fastify.get('/', { schema: { query: false, querystring: { type: 'object' } } }, async () => 'ok')
+  await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_SCH_DUPLICATE' })
+})
