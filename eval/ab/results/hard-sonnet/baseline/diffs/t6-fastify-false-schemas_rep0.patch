diff --git a/test/false-schema.test.js b/test/false-schema.test.js
new file mode 100644
index 0000000..5d17600
--- /dev/null
+++ b/test/false-schema.test.js
@@ -0,0 +1,62 @@
+'use strict'
+
+const { test } = require('node:test')
+const Fastify = require('..')
+
+for (const part of ['body', 'querystring', 'query', 'params', 'headers']) {
+  test(`false ${part} schema rejects every request`, async (t) => {
+    const fastify = Fastify()
+    let called = false
+    fastify.post('/:id', { schema: { [part]: false } }, async () => {
+      called = true
+      return 'ok'
+    })
+    const res = await fastify.inject({ method: 'POST', url: '/1', payload: { a: 1 } })
+    t.assert.strictEqual(res.statusCode, 400)
+    t.assert.strictEqual(called, false)
+  })
+
+  test(`custom validatorCompiler receives false ${part} schema`, async (t) => {
+    const fastify = Fastify()
+    const seen = []
+    fastify.setValidatorCompiler(({ schema, httpPart }) => {
+      seen.push([schema, httpPart])
+      return () => true
+    })
+    fastify.post('/:id', { schema: { [part]: false } }, async () => 'ok')
+    await fastify.ready()
+    const expected = part === 'query' ? 'querystring' : part
+    t.assert.deepStrictEqual(seen, [[false, expected]])
+  })
+
+  test(`null ${part} schema fails ready`, async (t) => {
+    const fastify = Fastify()
+    fastify.post('/:id', { schema: { [part]: null } }, async () => 'ok')
+    await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_SCH_VALIDATION_BUILD' })
+  })
+}
+
+test('query and querystring together still throw', async (t) => {
+  const fastify = Fastify()
+  fastify.get('/', { schema: { query: false, querystring: false } }, async () => 'ok')
+  await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_SCH_DUPLICATE' })
+})
+
+test('FSTWRN001 only for undefined schemas', async (t) => {
+  const warnings = []
+  const onWarning = (w) => { if (w.code === 'FSTWRN001') warnings.push(w.message) }
+  process.on('warning', onWarning)
+  t.after(() => process.removeListener('warning', onWarning))
+
+  const fastify = Fastify()
+  fastify.get('/a', { schema: { querystring: false } }, async () => 'ok')
+  await fastify.ready()
+  await new Promise(resolve => setImmediate(resolve))
+  t.assert.strictEqual(warnings.length, 0)
+
+  const f2 = Fastify()
+  f2.get('/b', { schema: { querystring: undefined } }, async () => 'ok')
+  await f2.ready()
+  await new Promise(resolve => setImmediate(resolve))
+  t.assert.strictEqual(warnings.length, 2) // GET and its HEAD route
+})
