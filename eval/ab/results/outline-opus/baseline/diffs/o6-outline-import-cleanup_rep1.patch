+  /**
+   * Delete the uploaded archive (if any) that the import was created from. The
+   * archive is stored as an attachment whose key is `scratch.storageKey`.
+   *
+   * @param importModel Import model whose archive should be removed.
+   * @param transaction Sequelize transaction.
+   * @returns Promise that resolves when the archive has been deleted.
+   */
+  private async destroyUploadedArchive(
+    importModel: Import<T>,
+    transaction: Transaction
+  ) {
+    const storageKey = importModel.scratch?.storageKey;
+    if (!storageKey) {
+      return;
+    }
+
+    const attachment = await Attachment.findOne({
+      where: { key: storageKey, teamId: importModel.teamId },
+      transaction,
+    });
+
+    await attachment?.destroy({ transaction });
+  }
