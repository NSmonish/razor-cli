diff --git a/server/models/Template.test.ts b/server/models/Template.test.ts
new file mode 100644
index 0000000..167ab51
--- /dev/null
+++ b/server/models/Template.test.ts
@@ -0,0 +1,45 @@
+import { EmptyResultError } from "sequelize";
+import { buildTemplate } from "@server/test/factories";
+import Template from "./Template";
+
+describe("#findByPk", () => {
+  it("should return template by id and urlId", async () => {
+    const template = await buildTemplate();
+
+    const byId = await Template.findByPk(template.id);
+    expect(byId?.id).toBe(template.id);
+
+    const byUrlId = await Template.findByPk(template.urlId);
+    expect(byUrlId?.id).toBe(template.id);
+  });
+
+  it("should return null for a malformed id without rejectOnEmpty", async () => {
+    await expect(Template.findByPk("invalid")).resolves.toBeNull();
+  });
+
+  it("should reject a missing id when rejectOnEmpty is passed", async () => {
+    await expect(
+      Template.findByPk("0e8280ea-7b4c-40e5-98ba-ec8a2f00f5e8", {
+        rejectOnEmpty: true,
+      })
+    ).rejects.toThrow(EmptyResultError);
+  });
+
+  it("should reject a malformed id when rejectOnEmpty is passed", async () => {
+    await expect(
+      Template.findByPk("invalid", { rejectOnEmpty: true })
+    ).rejects.toThrow(EmptyResultError);
+  });
+
+  it("should throw the passed error when rejectOnEmpty is an error", async () => {
+    const error = new Error("does not exist");
+    await expect(
+      Template.findByPk("0e8280ea-7b4c-40e5-98ba-ec8a2f00f5e8", {
+        rejectOnEmpty: error,
+      })
+    ).rejects.toThrow(error);
+    await expect(
+      Template.findByPk("invalid", { rejectOnEmpty: error })
+    ).rejects.toThrow(error);
+  });
+});
