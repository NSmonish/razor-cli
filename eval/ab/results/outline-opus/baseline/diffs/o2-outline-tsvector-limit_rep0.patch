+describe("searchVector", () => {
+  const matches = async (document: Document, query: string) => {
+    const [row] = await sequelize.query<{ match: boolean }>(
+      `SELECT "searchVector" @@ to_tsquery('english', :query) AS match FROM documents WHERE id = :id`,
+      {
+        replacements: { id: document.id, query },
+        type: QueryTypes.SELECT,
+      }
+    );
+    return row.match;
+  };
+
+  // Mostly unique tokens produce a tsvector larger than Postgres's 1MB limit
+  // while staying under the trigger's 1,000,000 character cap.
+  const uniqueTokens = (count: number) =>
+    Array.from({ length: count }, (_, i) => `tok${i}x`).join(" ");
+
+  test("should index title, previous titles and text with weights", async () => {
+    const document = await buildDocument({
+      title: "Alpha",
+      text: "bravo charlie",
+    });
+    document.title = "Delta";
+    await document.save();
+
+    expect(await matches(document, "delta:A")).toBe(true);
+    expect(await matches(document, "alpha:C")).toBe(true);
+    expect(await matches(document, "bravo:D & charlie:D")).toBe(true);
+  });
+
+  test("should index as much text as fits when the vector is too large", async () => {
+    const text = uniqueTokens(90000);
+    expect(text.length).toBeLessThan(1000000);
+
+    const document = await buildDocument({ title: "Alpha", text: "" });
+    document.title = "Delta";
+    document.text = text;
+    await document.save();
+
+    expect(await matches(document, "delta:A")).toBe(true);
+    expect(await matches(document, "alpha:C")).toBe(true);
+    expect(await matches(document, "tok0x:D")).toBe(true);
+    expect(await matches(document, "tok40000x:D")).toBe(true);
+    expect(await matches(document, "tok89999x")).toBe(false);
+  });
+
+  test("should allow creating a document with too large a vector", async () => {
+    const document = await buildDocument({
+      title: "Alpha",
+      text: uniqueTokens(90000),
+    });
+
+    expect(await matches(document, "alpha:A")).toBe(true);
+    expect(await matches(document, "tok0x:D")).toBe(true);
+  });
+});
