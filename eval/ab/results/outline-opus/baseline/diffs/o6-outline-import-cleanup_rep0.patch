+   */
+  private async deleteUploadedArchive(
+    importModel: Import<T>,
+    storageKey: string
+  ) {
+    try {
+      const attachment = await Attachment.findOne({
+        where: { key: storageKey, teamId: importModel.teamId },
+      });
+      await attachment?.destroy();
+    } catch (err) {
+      Logger.error(
+        "Failed to delete uploaded archive for import",
+        toError(err),
+        {
+          importId: importModel.id,
+        }
+      );
