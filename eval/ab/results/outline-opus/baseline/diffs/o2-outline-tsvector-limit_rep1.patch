+describe("searchVector", () => {
+  /**
+   * Builds text made of unique tokens that produces a tsvector larger than
+   * the Postgres size limit, while staying under the trigger's input cap.
+   */
+  const buildOversizedText = () =>
+    [
+      "beginningmarker",
+      ...Array.from({ length: 30000 }, (_, i) =>
+        createHash("md5").update(String(i)).digest("hex")
+      ),
+      "endingmarker",
+    ].join(" ");
+
+  const matches = async (documentId: string, query: string) => {
+    const [row] = await sequelize.query<{ matches: boolean }>(
+      `SELECT "searchVector" @@ to_tsquery('english', :query) AS matches FROM documents WHERE id = :documentId`,
+      {
+        type: QueryTypes.SELECT,
+        replacements: { documentId, query },
+      }
+    );
+    return row.matches;
+  };
+
+  test("should index the full text when it fits", async () => {
+    const document = await buildDocument({
+      title: "Quarterly roadmap",
+      text: "First paragraph with uniqueword at the end",
+    });
+
+    expect(await matches(document.id, "quarterly:A")).toBe(true);
+    expect(await matches(document.id, "uniqueword:D")).toBe(true);
+    expect(await matches(document.id, "uniqueword:A")).toBe(false);
+  });
+
+  test("should index a prefix of the text when the full text is too large", async () => {
+    const text = buildOversizedText();
+    expect(text.length).toBeLessThan(1000000);
+
+    const document = await buildDocument({
+      title: "Hashes",
+      text,
+    });
+
+    expect(await matches(document.id, "hashes:A")).toBe(true);
+    expect(await matches(document.id, "beginningmarker:D")).toBe(true);
+    expect(await matches(document.id, "endingmarker")).toBe(false);
+  });
+
+  test("should save oversized text on update and keep titles indexed", async () => {
+    const document = await buildDocument({
+      title: "Original heading",
+      text: "short text",
+    });
+    document.title = "Renamed heading";
+    await document.save();
+
+    document.text = buildOversizedText();
+    await expect(document.save()).resolves.toBeDefined();
+
+    const reloaded = await Document.findByPk(document.id);
+    expect(reloaded?.text).toEqual(document.text);
+    expect(await matches(document.id, "renamed:A")).toBe(true);
+    expect(await matches(document.id, "original:C")).toBe(true);
+    expect(await matches(document.id, "beginningmarker:D")).toBe(true);
+    expect(await matches(document.id, "short")).toBe(false);
+  });
+});
