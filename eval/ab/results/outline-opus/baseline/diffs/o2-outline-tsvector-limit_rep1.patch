+      "body" text;
+      "lo" integer;
+      "hi" integer;
+      "mid" integer;
+    begin
+      "titleVector" :=
+        setweight(to_tsvector('english', coalesce(new.title, '')),'A') ||
+        setweight(to_tsvector('english', coalesce(array_to_string(new."previousTitles", ' , '),'')),'C');
+      "body" := substring(coalesce(new.text, ''), 1, 1000000);
+
+      begin
+        new."searchVector" :=
+          "titleVector" ||
+          setweight(to_tsvector('english', "body"), 'D');
+        return new;
+      exception when program_limit_exceeded then
+        -- fall through to indexing a prefix of the text
+      end;
+
+      -- invariant: a prefix of length "lo" fits, a prefix of length "hi" does not
+      new."searchVector" := "titleVector";
+      "lo" := 0;
+      "hi" := length("body");
+
+      while "hi" - "lo" > greatest(1000, "hi" / 100) loop
