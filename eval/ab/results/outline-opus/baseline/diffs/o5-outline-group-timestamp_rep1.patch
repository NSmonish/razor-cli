@@ -77,6 +82,45 @@ class GroupUser extends Model<
   static async invalidateDocumentIdsAfterDestroy(model: GroupUser) {
     await Document.invalidateMembershipDocumentIds([model.userId]);
   }
+
+  @AfterCreate
+  static async touchGroupAfterCreate(
+    model: GroupUser,
+    options: CreateOptions<GroupUser>
+  ) {
+    await GroupUser.touchGroup(model, options);
+  }
+
+  @AfterDestroy
+  static async touchGroupAfterDestroy(
+    model: GroupUser,
+    options: InstanceDestroyOptions
+  ) {
+    await GroupUser.touchGroup(model, options);
+  }
+
+  /**
+   * Moves the parent group's updatedAt forward so that clients can detect that
+   * the membership has changed.
+   *
+   * @param model the group membership that was created or destroyed.
+   * @param options the hook options, used to share the transaction.
+   */
+  private static async touchGroup(
+    model: GroupUser,
+    options: CreateOptions<GroupUser> | InstanceDestroyOptions
+  ) {
+    // A static update that only sets updatedAt is skipped by Sequelize, so
+    // mark the timestamp as changed on an instance to force the write.
+    const group = Group.build({ id: model.groupId }, { isNewRecord: false });
+    group.changed("updatedAt", true);
+    await group.save({
+      fields: ["updatedAt"],
+      transaction: options.transaction,
+      hooks: false,
+      validate: false,
+    });
+  }
 }
 
 export default GroupUser;
