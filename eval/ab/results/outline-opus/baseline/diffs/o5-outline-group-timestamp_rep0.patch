diff --git a/server/models/GroupUser.test.ts b/server/models/GroupUser.test.ts
new file mode 100644
index 0000000..adf1e8d
--- /dev/null
+++ b/server/models/GroupUser.test.ts
@@ -0,0 +1,79 @@
+import { Group, GroupUser } from "@server/models";
+import { sequelize } from "@server/storage/database";
+import { buildGroup, buildGroupUser, buildUser } from "@server/test/factories";
+
+const past = new Date("2020-01-01T00:00:00.000Z");
+
+async function setGroupUpdatedAt(groupId: string, date: Date) {
+  await sequelize.query(
+    `UPDATE groups SET "updatedAt" = :date WHERE id = :id`,
+    {
+      replacements: { date, id: groupId },
+    }
+  );
+}
+
+async function getGroupUpdatedAt(groupId: string) {
+  const group = await Group.findByPk(groupId, { rejectOnEmpty: true });
+  return group.updatedAt;
+}
+
+describe("GroupUser", () => {
+  describe("hooks", () => {
+    it("should move group updatedAt forward when a member is added", async () => {
+      const user = await buildUser();
+      const group = await buildGroup({ teamId: user.teamId });
+      await setGroupUpdatedAt(group.id, past);
+
+      await GroupUser.create({
+        groupId: group.id,
+        userId: user.id,
+        createdById: user.id,
+      });
+
+      expect((await getGroupUpdatedAt(group.id)).getTime()).toBeGreaterThan(
+        past.getTime()
+      );
+    });
+
+    it("should move group updatedAt forward when a member is removed", async () => {
+      const user = await buildUser();
+      const group = await buildGroup({ teamId: user.teamId });
+      const groupUser = await buildGroupUser({
+        groupId: group.id,
+        userId: user.id,
+        teamId: user.teamId,
+      });
+      await setGroupUpdatedAt(group.id, past);
+
+      await groupUser.destroy();
+
+      expect((await getGroupUpdatedAt(group.id)).getTime()).toBeGreaterThan(
+        past.getTime()
+      );
+    });
+
+    it("should move group updatedAt forward within a transaction", async () => {
+      const user = await buildUser();
+      const group = await buildGroup({ teamId: user.teamId });
+      await buildGroupUser({
+        groupId: group.id,
+        userId: user.id,
+        teamId: user.teamId,
+      });
+      await setGroupUpdatedAt(group.id, past);
+
+      await sequelize.transaction(async (transaction) => {
+        await GroupUser.destroy({
+          where: { userId: user.id },
+          transaction,
+          individualHooks: true,
+        });
+      });
+
+      expect((await getGroupUpdatedAt(group.id)).getTime()).toBeGreaterThan(
+        past.getTime()
+      );
+    });
+  });
+});
