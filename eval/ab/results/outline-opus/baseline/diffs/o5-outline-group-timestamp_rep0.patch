@@ -77,6 +81,44 @@ class GroupUser extends Model<
   static async invalidateDocumentIdsAfterDestroy(model: GroupUser) {
     await Document.invalidateMembershipDocumentIds([model.userId]);
   }
+
+  @AfterCreate
+  static async touchGroupAfterCreate(
+    model: GroupUser,
+    options: { transaction?: Transaction | null }
+  ) {
+    await GroupUser.touchGroup(model.groupId, options.transaction);
+  }
+
+  @AfterDestroy
+  static async touchGroupAfterDestroy(
+    model: GroupUser,
+    options: { transaction?: Transaction | null }
+  ) {
+    await GroupUser.touchGroup(model.groupId, options.transaction);
+  }
+
+  /**
+   * Moves the group's updatedAt forward so that clients can detect that its
+   * membership has changed.
+   *
+   * @param groupId The id of the group to touch.
+   * @param transaction The transaction to run the update in, if any.
+   */
+  private static async touchGroup(
+    groupId: string,
+    transaction?: Transaction | null
+  ) {
+    const group = await Group.findByPk(groupId, { transaction });
+    if (!group) {
+      return;
+    }
+
+    // A bulk update that only sets updatedAt is skipped by Sequelize, so mark
+    // the timestamp as changed on the instance and save it instead.
+    group.changed("updatedAt", true);
+    await group.save({ transaction, hooks: false, validate: false });
+  }
 }
 
 export default GroupUser;
