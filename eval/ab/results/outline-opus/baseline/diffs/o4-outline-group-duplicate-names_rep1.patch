+  describe("name uniqueness", () => {
+    it("rejects duplicate names for groups without an externalId", async () => {
+      const group = await buildGroup({ name: "Marketing" });
+
+      await expect(
+        buildGroup({ teamId: group.teamId, name: "marketing" })
+      ).rejects.toThrow("The name of this group is already in use");
+    });
+
+    it("allows the same name in different teams", async () => {
+      await buildGroup({ name: "Marketing" });
+      await expect(buildGroup({ name: "Marketing" })).resolves.toBeTruthy();
+    });
+
+    it("allows the same name for groups with different externalIds", async () => {
+      const group = await buildGroup({ name: "Sales", externalId: "ext-1" });
+      const other = await buildGroup({
+        teamId: group.teamId,
+        name: "sales",
+        externalId: "ext-2",
+      });
+
+      // Re-validating either group must still succeed.
+      await group.update({ description: "Updated" });
+      await other.update({ description: "Updated" });
+      expect(other.name).toEqual("sales");
+    });
+
+    it("allows a manual group to share a name with an external group", async () => {
+      const group = await buildGroup({ name: "Sales", externalId: "ext-1" });
+      const manual = await buildGroup({ teamId: group.teamId, name: "Sales" });
+
+      await manual.update({ description: "Updated" });
+      await group.update({ description: "Updated" });
+      expect(manual.externalId).toBeFalsy();
+    });
+
+    it("rejects duplicate names for groups with the same externalId", async () => {
+      const group = await buildGroup({ name: "Sales", externalId: "ext-1" });
+
+      await expect(
+        buildGroup({ teamId: group.teamId, name: "SALES", externalId: "ext-1" })
+      ).rejects.toThrow("The name of this group is already in use");
+    });
+  });
