-import type { InferAttributes, InferCreationAttributes } from "sequelize";
+import type {
+  CreateOptions,
+  InferAttributes,
+  InferCreationAttributes,
+  InstanceDestroyOptions,
+} from "sequelize";
 import {
   AfterCreate,
   AfterDestroy,
@@ -77,6 +82,50 @@ class GroupUser extends Model<
   static async invalidateDocumentIdsAfterDestroy(model: GroupUser) {
     await Document.invalidateMembershipDocumentIds([model.userId]);
   }
+
+  @AfterCreate
+  static async touchGroupAfterCreate(
+    model: GroupUser,
+    options: CreateOptions<GroupUser>
+  ) {
+    await GroupUser.touchGroup(model, options);
+  }
+
+  @AfterDestroy
+  static async touchGroupAfterDestroy(
+    model: GroupUser,
+    options: InstanceDestroyOptions
+  ) {
+    await GroupUser.touchGroup(model, options);
+  }
+
+  /**
+   * Bump the parent group's updatedAt so that clients can detect that the
+   * group's membership has changed.
+   *
+   * @param model The group membership that was created or destroyed.
+   * @param options The options of the operation, used for the transaction.
+   */
+  private static async touchGroup(
+    model: GroupUser,
+    options: CreateOptions<GroupUser> | InstanceDestroyOptions
+  ) {
+    const group = await Group.findByPk(model.groupId, {
+      transaction: options.transaction,
+    });
+    if (!group) {
+      return;
+    }
+
+    // Sequelize skips updates where only the timestamp would change, so the
+    // attribute must be explicitly marked as changed.
+    group.changed("updatedAt", true);
+    await group.save({
+      transaction: options.transaction,
+      hooks: false,
+      validate: false,
+    });
+  }
 }
 
 export default GroupUser;
