diff --git a/server/models/Group.test.ts b/server/models/Group.test.ts
index 1cef326..53e5e29 100644
--- a/server/models/Group.test.ts
+++ b/server/models/Group.test.ts
@@ -171,4 +171,53 @@ describe("Group", () => {
       expect(await group.memberCount).toEqual(2);
     });
   });
+
+  describe("isUniqueNameInTeam", () => {
+    it("should not allow duplicate names for groups without externalId", async () => {
+      const group = await buildGroup({ name: "Engineering" });
+      await expect(
+        buildGroup({ name: "engineering", teamId: group.teamId })
+      ).rejects.toThrow("The name of this group is already in use");
+    });
+
+    it("should allow the same name in different teams", async () => {
+      await buildGroup({ name: "Engineering" });
+      await expect(buildGroup({ name: "Engineering" })).resolves.toBeTruthy();
+    });
+
+    it("should allow duplicate names for groups with different externalIds", async () => {
+      const group = await buildGroup({
+        name: "Engineering",
+        externalId: "ext-1",
+      });
+      const other = await buildGroup({
+        name: "Engineering",
+        externalId: "ext-2",
+        teamId: group.teamId,
+      });
+      const manual = await buildGroup({
+        name: "Engineering",
+        teamId: group.teamId,
+      });
+
+      // Re-validating existing groups should continue to succeed
+      await expect(group.update({ description: "a" })).resolves.toBeTruthy();
+      await expect(other.update({ description: "b" })).resolves.toBeTruthy();
+      await expect(manual.update({ description: "c" })).resolves.toBeTruthy();
+    });
+
+    it("should not allow duplicate names for groups with the same externalId", async () => {
+      const group = await buildGroup({
+        name: "Engineering",
+        externalId: "ext-1",
+      });
+      await expect(
+        buildGroup({
+          name: "ENGINEERING",
+          externalId: "ext-1",
+          teamId: group.teamId,
+        })
+      ).rejects.toThrow("The name of this group is already in use");
+    });
+  });
 });
