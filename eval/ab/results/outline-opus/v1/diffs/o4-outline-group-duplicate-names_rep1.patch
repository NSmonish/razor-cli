diff --git a/server/commands/groupsSyncer.test.ts b/server/commands/groupsSyncer.test.ts
index b58abcd..e43155e 100644
--- a/server/commands/groupsSyncer.test.ts
+++ b/server/commands/groupsSyncer.test.ts
@@ -258,4 +258,105 @@ describe("groupsSyncer", () => {
 
     expect(result.membershipsRemoved).toEqual(1);
   });
+
+  it("should allow external groups with duplicate names", async () => {
+    const user = await buildUser();
+    const team = await user.$get("team")!;
+    const authenticationProvider = (await AuthenticationProvider.findOne({
+      where: { teamId: user.teamId },
+    }))!;
+    const externalGroups = [
+      { id: "ext-1", name: "Engineering" },
+      { id: "ext-2", name: "Engineering" },
+      { id: "ext-3", name: "engineering" },
+    ];
+
+    const first = await sequelize.transaction(async (transaction) =>
+      groupsSyncer(createContext({ user, transaction, ip }), {
+        user,
+        team: team!,
+        authenticationProvider,
+        externalGroups,
+      })
+    );
+    expect(first.groupsCreated).toEqual(3);
+    expect(first.membershipsAdded).toEqual(3);
+
+    const groupsBefore = await Group.findAll({
+      where: { teamId: user.teamId },
+    });
+    expect(groupsBefore.map((g) => g.externalId).sort()).toEqual([
+      "ext-1",
+      "ext-2",
+      "ext-3",
+    ]);
+
+    const second = await sequelize.transaction(async (transaction) =>
+      groupsSyncer(createContext({ user, transaction, ip }), {
+        user,
+        team: team!,
+        authenticationProvider,
+        externalGroups,
+      })
+    );
+    expect(second.groupsCreated).toEqual(0);
+    expect(second.membershipsAdded).toEqual(0);
+    expect(second.membershipsRemoved).toEqual(0);
+
+    const groupsAfter = await Group.findAll({
+      where: { teamId: user.teamId },
+    });
+    expect(groupsAfter.map((g) => g.id).sort()).toEqual(
+      groupsBefore.map((g) => g.id).sort()
+    );
+  });
+
+  it("should repair previously synced groups without an externalId", async () => {
+    const user = await buildUser();
+    const team = await user.$get("team")!;
+    const authenticationProvider = (await AuthenticationProvider.findOne({
+      where: { teamId: user.teamId },
+    }))!;
+    const externalGroups = [
+      { id: "ext-1", name: "Engineering" },
+      { id: "ext-2", name: "Engineering" },
+    ];
+
+    await sequelize.transaction(async (transaction) =>
+      groupsSyncer(createContext({ user, transaction, ip }), {
+        user,
+        team: team!,
+        authenticationProvider,
+        externalGroups,
+      })
+    );
+
+    // Simulate groups created by an earlier version that did not store the
+    // externalId on the internal group.
+    await sequelize
+      .getQueryInterface()
+      .bulkUpdate("groups", { externalId: null }, { teamId: user.teamId }, {});
+
+    const result = await sequelize.transaction(async (transaction) =>
+      groupsSyncer(createContext({ user, transaction, ip }), {
+        user,
+        team: team!,
+        authenticationProvider,
+        externalGroups: [
+          { id: "ext-1", name: "Engineering", description: "First" },
+          { id: "ext-2", name: "Engineering", description: "Second" },
+        ],
+      })
+    );
+    expect(result.groupsCreated).toEqual(0);
+
+    const groups = await Group.findAll({
+      where: { teamId: user.teamId },
+      order: [["externalId", "ASC"]],
+    });
+    expect(groups.map((g) => [g.externalId, g.description])).toEqual([
+      ["ext-1", "First"],
+      ["ext-2", "Second"],
+    ]);
+  });
 });
