+import { ImportState, IntegrationService } from "@shared/types";
+import { Attachment, Import } from "@server/models";
+import FileStorage from "@server/storage/files";
+import { buildAttachment, buildImport, buildUser } from "@server/test/factories";
+import JSONImportsProcessor from "./JSONImportsProcessor";
+
+const ip = "127.0.0.1";
+
+async function setup(state: ImportState) {
+  const user = await buildUser();
+  const attachment = await buildAttachment({
+    teamId: user.teamId,
+    userId: user.id,
+  });
+  const importModel = await buildImport({
+    service: IntegrationService.JSON,
+    state,
+    integrationId: null,
+    teamId: user.teamId,
+    createdById: user.id,
+    scratch: { storageKey: attachment.key },
+  });
+
+  return { user, attachment, importModel };
+}
+
+describe("ImportsProcessor", () => {
+  describe("imports.processed", () => {
+    it("should delete the uploaded archive and clear scratch on completion", async () => {
+      const deleteFile = vi
+        .spyOn(FileStorage, "deleteFile")
+        .mockResolvedValue(undefined);
+      const { user, attachment, importModel } = await setup(
+        ImportState.Processed
+      );
+      const otherAttachment = await buildAttachment({
+        teamId: user.teamId,
+        userId: user.id,
+      });
+
+      await new JSONImportsProcessor().perform({
+        name: "imports.processed",
+        modelId: importModel.id,
+        teamId: user.teamId,
+        actorId: user.id,
+        ip,
+        changes: { attributes: {}, previous: {} },
+      });
+
+      await importModel.reload();
+      expect(importModel.state).toEqual(ImportState.Completed);
+      expect(importModel.scratch).toBeNull();
+      expect(await Attachment.findByPk(attachment.id)).toBeNull();
+      expect(deleteFile).toHaveBeenCalledWith(attachment.key);
+      expect(await Attachment.findByPk(otherAttachment.id)).not.toBeNull();
+    });
+
+    it("should not delete an attachment belonging to another team", async () => {
+      vi.spyOn(FileStorage, "deleteFile").mockResolvedValue(undefined);
+      const { user, importModel } = await setup(ImportState.Processed);
+      const otherTeamUser = await buildUser();
+      const otherTeamAttachment = await buildAttachment({
+        teamId: otherTeamUser.teamId,
+        userId: otherTeamUser.id,
+      });
+      await importModel.update({
+        scratch: { storageKey: otherTeamAttachment.key },
+      });
+
+      await new JSONImportsProcessor().perform({
+        name: "imports.processed",
+        modelId: importModel.id,
+        teamId: user.teamId,
+        actorId: user.id,
+        ip,
+        changes: { attributes: {}, previous: {} },
+      });
+
+      await importModel.reload();
+      expect(importModel.state).toEqual(ImportState.Completed);
+      expect(await Attachment.findByPk(otherTeamAttachment.id)).not.toBeNull();
+    });
+
+    it.each([ImportState.Errored, ImportState.Canceled])(
+      "should keep the uploaded archive when the import is %s",
+      async (state) => {
+        const deleteFile = vi
+          .spyOn(FileStorage, "deleteFile")
+          .mockResolvedValue(undefined);
+        const { user, attachment, importModel } = await setup(state);
+
+        await new JSONImportsProcessor().perform({
+          name: "imports.processed",
+          modelId: importModel.id,
+          teamId: user.teamId,
+          actorId: user.id,
+          ip,
+          changes: { attributes: {}, previous: {} },
+        });
+
+        const reloaded = await Import.findByPk(importModel.id);
+        expect(reloaded?.state).toEqual(state);
+        expect(reloaded?.scratch).toEqual({ storageKey: attachment.key });
+        expect(await Attachment.findByPk(attachment.id)).not.toBeNull();
+        expect(deleteFile).not.toHaveBeenCalledWith(attachment.key);
+      }
+    );
+  });
+});
