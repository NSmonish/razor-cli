+describe("searchVector", () => {
+  const matches = async (document: Document, query: string) => {
+    const [row] = await sequelize.query<{ matches: boolean }>(
+      `SELECT "searchVector" @@ to_tsquery('english', :query) AS matches FROM documents WHERE id = :id`,
+      {
+        type: QueryTypes.SELECT,
+        replacements: { id: document.id, query },
+      }
+    );
+    return row.matches;
+  };
+
+  const lexemeCount = async (document: Document) => {
+    const [row] = await sequelize.query<{ count: number }>(
+      `SELECT length("searchVector") AS count FROM documents WHERE id = :id`,
+      { type: QueryTypes.SELECT, replacements: { id: document.id } }
+    );
+    return Number(row.count);
+  };
+
+  // Text made of unique tokens produces a tsvector larger than the input, so
+  // this stays below the 1,000,000 character input cap yet exceeds the 1MB
+  // tsvector limit when indexed in full.
+  const uniqueTokens = (length: number) => {
+    const tokens: string[] = [];
+    let size = 0;
+    while (size < length) {
+      const token = randomBytes(16).toString("hex");
+      tokens.push(token);
+      size += token.length + 1;
+    }
+    return tokens.join(" ");
+  };
+
+  test("should index title, previous titles and text", async () => {
+    const document = await buildDocument({
+      title: "Quarterly",
+      text: "aardvark in the middle zebra",
+    });
+    document.title = "Annual";
+    await document.save();
+
+    expect(await matches(document, "annual:A")).toBe(true);
+    expect(await matches(document, "quarterly:C")).toBe(true);
+    expect(await matches(document, "aardvark:D")).toBe(true);
+    expect(await matches(document, "zebra:D")).toBe(true);
+  });
+
+  test("should save text whose full search vector is too large", async () => {
+    const document = await buildDocument({ title: "Quarterly" });
+    document.title = "Annual";
+    await document.save();
+
+    const text = `aardvark ${uniqueTokens(990000)} zebra`;
+    expect(text.length).toBeLessThan(1000000);
+    document.text = text;
+    await document.save();
+
+    const reloaded = await Document.unscoped().findByPk(document.id, {
+      rejectOnEmpty: true,
+    });
+    expect(reloaded.text).toBe(text);
+
+    // Titles remain fully indexed with their usual weights.
+    expect(await matches(document, "annual:A")).toBe(true);
+    expect(await matches(document, "quarterly:C")).toBe(true);
+
+    // The beginning of the text is indexed, the end is not.
+    expect(await matches(document, "aardvark:D")).toBe(true);
+    expect(await matches(document, "zebra")).toBe(false);
+
+    // As much of the text as fits is indexed, not just a token or two.
+    expect(await lexemeCount(document)).toBeGreaterThan(20000);
+  });
+});
+
