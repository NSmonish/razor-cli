+"use strict";
+
+/**
+ * Postgres limits the size of a tsvector to 1MB. Capping the input text is not
+ * enough to stay below it: text made of mostly unique tokens (hashes, IDs,
+ * base64) can produce a vector larger than the input. When the full vector is
+ * too large, binary search for the longest prefix of the text that fits, while
+ * always indexing the title and previous titles in full.
+ */
+
+/** @type {import('sequelize-cli').Migration} */
+module.exports = {
+  async up(queryInterface) {
+    await queryInterface.sequelize.query(`
+    CREATE OR REPLACE FUNCTION documents_search_trigger() RETURNS trigger AS $$
+    declare
+      title_vector tsvector;
+      body text;
+      lo integer;
+      hi integer;
+      mid integer;
+    begin
+      title_vector :=
+        setweight(to_tsvector('english', coalesce(new.title, '')),'A') ||
+        setweight(to_tsvector('english', coalesce(array_to_string(new."previousTitles", ' , '),'')),'C');
+      body := substring(coalesce(new.text, ''), 1, 1000000);
+
+      begin
+        new."searchVector" := title_vector || setweight(to_tsvector('english', body), 'D');
+        return new;
+      exception when program_limit_exceeded then
+        -- The vector is too large, fall through and index a prefix of the text.
+      end;
+
+      -- Invariant: a prefix of length lo fits, a prefix of length hi does not.
+      lo := 0;
+      hi := length(body);
+      new."searchVector" := title_vector;
+
+      while hi - lo > 1000 loop
+        mid := lo + (hi - lo) / 2;
+        begin
+          new."searchVector" := title_vector || setweight(to_tsvector('english', substring(body, 1, mid)), 'D');
+          lo := mid;
+        exception when program_limit_exceeded then
+          hi := mid;
+        end;
+      end loop;
+
+      return new;
+    end
+    $$ LANGUAGE plpgsql;
+    `);
+  },
+
+  async down(queryInterface) {
+    await queryInterface.sequelize.query(`
+    CREATE OR REPLACE FUNCTION documents_search_trigger() RETURNS trigger AS $$
