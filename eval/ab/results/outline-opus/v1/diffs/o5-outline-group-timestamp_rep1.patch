+++ b/server/models/GroupUser.test.ts
@@ -0,0 +1,37 @@
+import { Group } from "@server/models";
+import { buildGroup, buildGroupUser, buildUser } from "@server/test/factories";
+
+describe("GroupUser", () => {
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("should move the group updatedAt forward when a member joins", async () => {
+    const group = await buildGroup();
+    const later = new Date(group.updatedAt.getTime() + 60000);
+    vi.useFakeTimers({ toFake: ["Date"], now: later });
+
+    await buildGroupUser({ groupId: group.id, teamId: group.teamId });
+
+    const reloaded = await Group.findByPk(group.id);
+    expect(reloaded!.updatedAt.getTime()).toEqual(later.getTime());
+  });
+
+  it("should move the group updatedAt forward when a member leaves", async () => {
+    const group = await buildGroup();
+    const user = await buildUser({ teamId: group.teamId });
+    const groupUser = await buildGroupUser({
+      groupId: group.id,
+      teamId: group.teamId,
+      userId: user.id,
+    });
+    const before = (await Group.findByPk(group.id))!.updatedAt;
+    const later = new Date(before.getTime() + 60000);
+    vi.useFakeTimers({ toFake: ["Date"], now: later });
+
+    await groupUser.destroy();
+
+    const reloaded = await Group.findByPk(group.id);
+    expect(reloaded!.updatedAt.getTime()).toEqual(later.getTime());
+  });
+});
