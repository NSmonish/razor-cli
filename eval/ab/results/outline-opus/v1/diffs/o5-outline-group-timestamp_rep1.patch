+import type {
+  CreateOptions,
+  InferAttributes,
+  InferCreationAttributes,
+  InstanceDestroyOptions,
+} from "sequelize";
 import {
   AfterCreate,
   AfterDestroy,
@@ -77,6 +82,50 @@ class GroupUser extends Model<
   static async invalidateDocumentIdsAfterDestroy(model: GroupUser) {
     await Document.invalidateMembershipDocumentIds([model.userId]);
   }
+
+  @AfterCreate
+  static async touchGroupAfterCreate(
+    model: GroupUser,
+    options: CreateOptions<GroupUser>
+  ) {
+    await GroupUser.touchGroup(model, options);
+  }
+
+  @AfterDestroy
+  static async touchGroupAfterDestroy(
+    model: GroupUser,
+    options: InstanceDestroyOptions
+  ) {
+    await GroupUser.touchGroup(model, options);
+  }
+
+  /**
+   * Moves the group's updatedAt forward so that clients can detect that the
+   * membership has changed.
+   *
+   * @param model The group user that was created or destroyed.
+   * @param options The options passed to the hook, used for the transaction.
+   */
+  private static async touchGroup(
+    model: GroupUser,
+    options: CreateOptions<GroupUser> | InstanceDestroyOptions
+  ) {
+    const group = await Group.findByPk(model.groupId, {
+      transaction: options.transaction,
+    });
+    if (!group) {
+      return;
+    }
+
+    // Static update skips queries that only set updatedAt, so mark the
+    // timestamp as changed on the instance and save it instead.
+    group.changed("updatedAt", true);
+    await group.save({
+      transaction: options.transaction,
+      hooks: false,
+      validate: false,
+    });
+  }
 }
 
 export default GroupUser;
