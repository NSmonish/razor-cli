+/** @type {import('sequelize-cli').Migration} */
+module.exports = {
+  async up(queryInterface) {
+    // Postgres limits the size of a tsvector (~1MB), not the size of its input.
+    // Text made of mostly unique tokens (hashes, IDs, base64, tables of
+    // numbers) can exceed that limit well before the 1,000,000 character cap.
+    // When that happens, index the longest prefix of the text that fits while
+    // still indexing the title and previous titles in full.
+    await queryInterface.sequelize.query(`
+    CREATE OR REPLACE FUNCTION documents_search_trigger() RETURNS trigger AS $$
+    declare
+      titles_vector tsvector;
+      body text;
+      fits integer;
+      too_long integer;
+      candidate integer;
+    begin
+      titles_vector :=
+        setweight(to_tsvector('english', coalesce(new.title, '')),'A') ||
+        setweight(to_tsvector('english', coalesce(array_to_string(new."previousTitles", ' , '),'')),'C');
+      body := substring(coalesce(new.text, ''), 1, 1000000);
+
+      begin
+        new."searchVector" := titles_vector || setweight(to_tsvector('english', body), 'D');
+        return new;
+      exception when program_limit_exceeded then
+        -- fall through to index a prefix of the text
+      end;
+
+      -- Binary search for the longest prefix of the text that fits, to within
+      -- 1,000 characters.
+      fits := 0;
+      too_long := length(body);
+      while too_long - fits > 1000 loop
+        candidate := fits + (too_long - fits) / 2;
+        begin
+          perform titles_vector || to_tsvector('english', substring(body, 1, candidate));
+          fits := candidate;
+        exception when program_limit_exceeded then
+          too_long := candidate;
+        end;
+      end loop;
+
+      new."searchVector" := titles_vector || setweight(to_tsvector('english', substring(body, 1, fits)), 'D');
+      return new;
+    end
+    $$ LANGUAGE plpgsql;
+    `);
+  },
