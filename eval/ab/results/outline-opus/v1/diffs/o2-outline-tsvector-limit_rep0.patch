+describe("searchVector", () => {
+  // Text of unique tokens that is under the 1,000,000 character cap of the
+  // search trigger, but produces a tsvector over Postgres' ~1MB size limit.
+  const tokens = Array.from({ length: 29000 }, (_, i) =>
+    createHash("md5").update(String(i)).digest("hex")
+  );
+  const largeText = tokens.join(" ");
+
+  const getSearchVector = async (id: string) => {
+    const [row] = await sequelize.query<{ searchVector: string }>(
+      `SELECT "searchVector"::text AS "searchVector" FROM documents WHERE id = :id`,
+      { type: QueryTypes.SELECT, replacements: { id } }
+    );
+    return row.searchVector;
+  };
+
+  const matches = async (id: string, query: string) => {
+    const [row] = await sequelize.query<{ matches: boolean }>(
+      `SELECT "searchVector" @@ plainto_tsquery('english', :query) AS matches FROM documents WHERE id = :id`,
+      { type: QueryTypes.SELECT, replacements: { id, query } }
+    );
+    return row.matches;
+  };
+
+  test("should index the full text when it fits", async () => {
+    const document = await buildDocument({
+      title: "Quokka",
+      previousTitles: ["Wombat"],
+      text: "Kangaroo platypus",
+    });
+
+    const searchVector = await getSearchVector(document.id);
+    expect(searchVector).toMatch(/'quokka':\d+A/);
+    expect(searchVector).toMatch(/'wombat':\d+C/);
+    expect(searchVector).toMatch(/'kangaroo':\d+(?![A-C])/);
+    expect(searchVector).toMatch(/'platypus':\d+(?![A-C])/);
+  });
+
+  test("should save text that produces a search vector over the size limit", async () => {
+    expect(largeText.length).toBeLessThan(1000000);
+
+    const document = await buildDocument({
+      title: "Quokka",
+      previousTitles: ["Wombat"],
+      content: parser.parse("Small")?.toJSON(),
+      text: largeText,
+    });
+
+    const searchVector = await getSearchVector(document.id);
+    expect(searchVector).toMatch(/'quokka':\d+A/);
+    expect(searchVector).toMatch(/'wombat':\d+C/);
+    expect(await matches(document.id, tokens[0])).toBe(true);
+    expect(await matches(document.id, tokens[1000])).toBe(true);
+    expect(await matches(document.id, tokens[tokens.length - 1])).toBe(false);
+  });
+
+  test("should update text that produces a search vector over the size limit", async () => {
+    const document = await buildDocument({
+      title: "Quokka",
+      previousTitles: ["Wombat"],
+      text: "Kangaroo",
+    });
+
+    await Document.update(
+      { text: largeText },
+      { where: { id: document.id }, hooks: false }
+    );
+    await document.reload();
+    expect(document.text).toEqual(largeText);
+
+    const searchVector = await getSearchVector(document.id);
+    expect(searchVector).toMatch(/'quokka':\d+A/);
+    expect(searchVector).toMatch(/'wombat':\d+C/);
+    expect(searchVector).not.toContain("'kangaroo'");
+    expect(await matches(document.id, tokens[0])).toBe(true);
+    expect(await matches(document.id, tokens[tokens.length - 1])).toBe(false);
+  });
+});
