   return DBResponse;
 };
 
+const orderStatuses = ['processing', 'shipped', 'delivered', 'cancelled', 'returned'];
+const allowedStatusTransitions = {
+  processing: ['shipped', 'cancelled'],
+  shipped: ['delivered'],
+  delivered: ['returned'],
+  cancelled: [],
+  returned: [],
+};
+
+module.exports.changeOrderStatus = async function (id, newStatus) {
+  if (!orderStatuses.includes(newStatus)) {
+    throw new AppError('invalid-status', `Unknown order status ${newStatus}`, 400);
+  }
+  const orderRepository = new OrderRepository();
+  const order = await orderRepository.getOrderById(id);
+  if (!order) {
+    throw new AppError('order-not-found', `Order ${id} was not found`, 404);
+  }
+  const currentStatus = order.status;
+  if (!allowedStatusTransitions[currentStatus].includes(newStatus)) {
+    throw new AppError(
+      'invalid-status-transition',
+      `Order ${id} can't move from ${currentStatus} to ${newStatus}`,
+      409,
+    );
+  }
+  const updatedOrder = await orderRepository.updateStatus(id, newStatus);
+  await new MessageQueueClient().publish(
+    'order.events',
+    'order.events.status-changed',
+    { orderId: Number(id), from: currentStatus, to: newStatus },
+  );
+  return updatedOrder;
+};
+
 module.exports.deleteOrder = async function (id) {
   return await new OrderRepository().deleteOrder(id);
 };
