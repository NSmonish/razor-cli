+// query values arrive as strings; only plain non-negative integers are accepted
+function parseNonNegativeInteger(value, name) {
+  if (typeof value !== 'string' || !/^\d+$/.test(value)) {
+    throw new AppError('invalid-query', `${name} must be a non-negative integer`, 400);
+  }
+  return parseInt(value, 10);
+}
+
+module.exports.listOrders = async function (query) {
+  const userId =
+    query.userId === undefined ? undefined : parseNonNegativeInteger(query.userId, 'userId');
+  const limit = query.limit === undefined ? 20 : parseNonNegativeInteger(query.limit, 'limit');
+  const offset = query.offset === undefined ? 0 : parseNonNegativeInteger(query.offset, 'offset');
+  if (limit < 1 || limit > 100) {
+    throw new AppError('invalid-query', 'limit must be between 1 and 100', 400);
+  }
+  return await new OrderRepository().listOrders({ userId, limit, offset });
+};
+
 module.exports.getOrder = async function (id) {
   return await new OrderRepository().getOrderById(id);
 };
